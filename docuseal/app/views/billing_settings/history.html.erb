<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0 md:space-x-8 px-3 sm:px-6">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-3xl">
    <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-center mb-6">
      <div>
        <div class="flex items-center space-x-2 text-xs opacity-70 mb-1">
          <%= link_to settings_billing_index_path, class: 'hover:underline flex items-center gap-1 font-medium' do %>
            <%= svg_icon('arrow_left', class: 'w-3 h-3') rescue '' %>
            <span>Back to Billing</span>
          <% end %>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold">
          API Usage & Billing Activity
        </h1>
        <p class="text-sm opacity-70 mt-1">
          Complete transaction record of all eSignature API charges.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0 self-start md:self-auto">
        <%= link_to history_settings_billing_index_path(params.permit(:start_date, :end_date).merge(format: :csv)), class: 'btn btn-primary btn-sm gap-2' do %>
          <%= svg_icon('download', class: 'w-4 h-4') rescue '' %>
          <span>Download CSV</span>
        <% end %>
      </div>
    </div>

    <!-- Date Range Filter Form -->
    <div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
      <div class="card-body p-4">
        <%= form_with url: history_settings_billing_index_path, method: :get, local: true, class: 'flex flex-wrap items-end gap-3' do %>
          <div class="flex-1 min-w-[140px]">
            <label class="block text-xs uppercase tracking-wider font-semibold opacity-60 mb-1">
              Start Date
            </label>
            <input type="date" name="start_date" value="<%= params[:start_date] %>" class="input input-bordered input-sm w-full" />
          </div>

          <div class="flex-1 min-w-[140px]">
            <label class="block text-xs uppercase tracking-wider font-semibold opacity-60 mb-1">
              End Date
            </label>
            <input type="date" name="end_date" value="<%= params[:end_date] %>" class="input input-bordered input-sm w-full" />
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button type="submit" class="btn btn-sm btn-neutral gap-1">
              <%= svg_icon('search', class: 'w-3.5 h-3.5') rescue '' %>
              <span>Filter</span>
            </button>

            <% if params[:start_date].present? || params[:end_date].present? %>
              <%= link_to 'Clear', history_settings_billing_index_path, class: 'btn btn-sm btn-ghost' %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- All Activity Card -->
    <div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
      <div class="card-body p-6">
        <% if @transactions.present? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-sm">
              <thead>
                <tr class="text-xs uppercase opacity-60">
                  <th>Date</th>
                  <th>Document / Submitter</th>
                  <th>Type</th>
                  <th>Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.each do |tx| %>
                  <tr>
                    <td class="font-mono text-xs opacity-70 whitespace-nowrap">
                      <%= (tx.completed_at || tx.created_at)&.in_time_zone(current_account&.timezone || 'Singapore')&.strftime('%b %d, %Y %H:%M') %>
                    </td>
                    <td>
                      <div class="font-medium text-base-content">
                        <%= tx.submission&.name.presence || "Submission ##{tx.submission_id}" %>
                      </div>
                      <div class="text-xs opacity-60">
                        <%= tx.submitter&.email || tx.submitter&.name || "Submitter ##{tx.submitter_id}" %>
                      </div>
                    </td>
                    <td>
                      <% channel = Billing.transaction_channel(tx) %>
                      <% if channel == 'WhatsApp' %>
                        <span class="badge badge-sm badge-success badge-outline font-medium whitespace-nowrap">
                          WhatsApp API eSignature
                        </span>
                      <% elsif channel == 'Portal' %>
                        <span class="badge badge-sm badge-info badge-outline font-medium whitespace-nowrap">
                          Portal API eSignature
                        </span>
                      <% elsif channel == 'API' %>
                        <span class="badge badge-sm badge-neutral badge-outline font-medium whitespace-nowrap">
                          API eSignature
                        </span>
                      <% end %>
                    </td>
                    <td class="font-mono font-medium text-error whitespace-nowrap">
                      -$<%= sprintf('%.2f', Billing::PRICE_PER_SIGNATURE) %> USD
                    </td>
                    <td>
                      <span class="badge badge-sm badge-success gap-1">
                        <%= svg_icon('check', class: 'w-3 h-3') rescue '' %> Paid
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @pagy && @pagy.pages > 1 %>
            <%= render 'shared/pagination', pagy: @pagy, items_name: 'transactions' %>
          <% end %>
        <% else %>
          <div class="text-center py-8 bg-base-100 rounded-lg border border-dashed border-base-300">
            <%= svg_icon('file_text', class: 'w-10 h-10 opacity-30 mx-auto mb-2') rescue '' %>
            <p class="font-medium opacity-80">
              <% if params[:start_date].present? || params[:end_date].present? %>
                No API signature charges found for the selected date range
              <% else %>
                No API signature charges found
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
