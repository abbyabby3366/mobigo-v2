<% is_templates = local_assigns[:selected] == 'templates' %>
<% is_submissions = local_assigns[:selected] == 'submissions' %>
<% is_by_date = local_assigns[:selected] == 'submissions_by_date' %>

<form action="<%= root_path %>" method="get" id="templates_submissions_toggle" class="bg-base-200 px-1.5 rounded-xl py-1 whitespace-nowrap inline-flex items-center space-x-1">
  <% unless current_user&.viewer? %>
    <toggle-cookies data-value="templates" data-key="dashboard_view" class="tooltip tooltip-top tooltip-no-touch" data-tip="<%= t('templates') %>">
      <button name="dashboard_view" value="templates" class="<%= is_templates ? 'btn btn-neutral !rounded-lg btn-square !p-0 hover:text-neutral-300 !btn-sm !h-8 !w-9 disabled:btn-neutral' : 'btn !border !rounded-lg btn-square !p-0 !btn-sm !h-8 !w-9' %>">
        <%= svg_icon('layout_grid', class: 'w-6 h-6 stroke-2') %>
      </button>
    </toggle-cookies>
  <% end %>
  <toggle-cookies data-value="submissions" data-key="dashboard_view" class="tooltip tooltip-top tooltip-no-touch" data-tip="<%= t('submissions') %>">
    <button name="dashboard_view" value="submissions" class="<%= is_submissions ? 'btn btn-neutral !rounded-lg btn-square !p-0 hover:text-neutral-300 !btn-sm !h-8 !w-9 disabled:btn-neutral' : 'btn !border !rounded-lg btn-square !p-0 !btn-sm !h-8 !w-9' %>">
      <%= svg_icon('layout_list', class: 'w-6 h-6 stroke-2') %>
    </button>
  </toggle-cookies>
  <toggle-cookies data-value="submissions_by_date" data-key="dashboard_view" class="tooltip tooltip-top tooltip-no-touch" data-tip="<%= t('submissions_by_date', default: 'Submissions by date') %>">
    <button name="dashboard_view" value="submissions_by_date" class="<%= is_by_date ? 'btn btn-neutral !rounded-lg btn-square !p-0 hover:text-neutral-300 !btn-sm !h-8 !w-9 disabled:btn-neutral' : 'btn !border !rounded-lg btn-square !p-0 !btn-sm !h-8 !w-9' %>">
      <%= svg_icon('calendar', class: 'w-6 h-6 stroke-2') %>
    </button>
  </toggle-cookies>
</form>
