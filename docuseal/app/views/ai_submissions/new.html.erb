<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<div class="space-y-6 max-w-5xl mx-auto py-2">
  <!-- Back Link & Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-base-300">
    <div>
      <div class="flex items-center space-x-2 text-xs text-base-content/60 mb-1">
        <%= link_to submissions_path, data: { turbo: false }, class: 'hover:text-primary flex items-center space-x-1 font-medium' do %>
          <%= svg_icon('arrow_left', class: 'w-3.5 h-3.5') %>
          <span>Submissions</span>
        <% end %>
        <span>/</span>
        <span class="text-base-content/90 font-medium">Create with AI</span>
      </div>
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-neutral-900 rounded-xl text-yellow-400 shadow-sm">
          <%= svg_icon('sparkles', class: 'w-6 h-6 stroke-2') %>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-2xl font-bold text-base-content">Create Submission with AI</h1>
            <button type="button" id="toggle_prompt_fields_btn" onclick="togglePromptAndFields()" class="p-1.5 rounded-lg border border-base-300 bg-base-100 hover:bg-base-200 text-base-content/70 hover:text-base-content transition-all inline-flex items-center justify-center cursor-pointer shadow-2xs" title="Show Template Fields & AI System Prompt">
              <span id="icon_hidden_state" class="flex items-center"><%= svg_icon('eye_off', class: 'w-4 h-4') %></span>
              <span id="icon_shown_state" class="hidden flex items-center"><%= svg_icon('eye', class: 'w-4 h-4') %></span>
            </button>
          </div>
          <p class="text-xs text-base-content/60 mt-0.5">Extract customer details, MyKad IC, calculator terms & box IMEI with Gemini 3.6 Flash</p>
        </div>
      </div>
    </div>
  </div>

  <div id="ai_submission_wizard" class="space-y-6">
    <!-- 2-Column Setup Grid for Step 1 & Step 2 -->
    <div id="ai_setup_grid" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Left Column: Template Selection & Required Fields (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-5 shadow-sm space-y-4">
          <div>
            <label for="ai_template_select" class="block text-xs font-bold uppercase tracking-wider text-base-content/80 mb-2">
              1. Select Document Template
            </label>
            <% if @templates.blank? %>
              <div class="alert alert-warning text-xs p-3 rounded-xl">
                <%= svg_icon('alert_circle', class: 'w-4 h-4') %>
                <span>No active templates found. Please create a template first.</span>
              </div>
            <% else %>
              <input type="hidden" id="ai_template_select" name="template_id" value="<%= @template&.id || @templates.first&.id %>">
              <div class="grid grid-cols-1 gap-2.5" id="template_buttons_group">
                <% @templates.each do |tmpl| %>
                  <% tmpl_fields = tmpl.fields.to_a %>
                  <% sig_count = tmpl_fields.count { |f| f['type'] == 'signature' } %>
                  <% data_count = tmpl_fields.size - sig_count %>
                  <% desc_parts = ["#{data_count} #{'field'.pluralize(data_count)}"] %>
                  <% desc_parts << "#{sig_count} #{'signature'.pluralize(sig_count)}" if sig_count.positive? %>
                  <% is_selected = (tmpl.id == (@template&.id || @templates.first&.id)) %>
                  
                  <button type="button" 
                          data-action="select-template" 
                          data-template-id="<%= tmpl.id %>"
                          style="<%= is_selected ? 'background-color: #18181b !important; color: #ffffff !important; border: 2px solid #2563eb !important; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15) !important;' : 'background-color: #ffffff !important; color: #18181b !important; border: 1.5px solid #e4e4e7 !important; box-shadow: none !important;' %>"
                          class="template-option-btn text-left p-3.5 rounded-xl transition-all flex items-center justify-between cursor-pointer w-full">
                    <div class="flex items-center space-x-3 truncate pointer-events-none">
                      <div class="p-2 rounded-lg transition-colors icon-box flex items-center justify-center"
                           style="<%= is_selected ? 'background-color: #27272a !important; color: #facc15 !important;' : 'background-color: #f4f4f5 !important; color: #52525b !important;' %>">
                        <%= svg_icon('file_text', class: 'w-4 h-4 stroke-2') %>
                      </div>
                      <div class="truncate">
                        <div class="font-bold text-xs tmpl-name"
                             style="<%= is_selected ? 'color: #ffffff !important; font-weight: 700 !important;' : 'color: #18181b !important; font-weight: 700 !important;' %>">
                          <%= tmpl.name %>
                        </div>
                        <div class="text-[11px] tmpl-desc"
                             style="<%= is_selected ? 'color: #d4d4d8 !important; font-weight: 500 !important;' : 'color: #71717a !important; font-weight: 500 !important;' %>">
                          <%= desc_parts.join(', ') %>
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center space-x-2 flex-shrink-0 pointer-events-none">
                      <span class="check-badge"
                            style="<%= is_selected ? 'display: inline-flex !important; align-items: center !important; gap: 4px !important; background-color: #2563eb !important; color: #ffffff !important; font-weight: 700 !important; font-size: 11px !important; padding: 4px 10px !important; border-radius: 8px !important;' : 'display: none !important;' %>">
                        <%= svg_icon('check', class: 'w-3.5 h-3.5 stroke-2 text-white') %>
                        Selected
                      </span>
                    </div>
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Hidden section for Template Fields & AI System Prompt (toggled via Eye icon beside title) -->
          <div id="ai_template_prompt_details" class="hidden space-y-4 pt-2 border-t border-base-200">
            <!-- Template Fields Container -->
            <div id="template_fields_container">
              <% if @template %>
                <%= render 'template_fields', template: @template %>
              <% end %>
            </div>

            <!-- AI System Prompt Accordion (Collapsed by Default) -->
            <div class="bg-base-200/80 rounded-2xl border border-base-300 overflow-hidden shadow-2xs">
              <details class="group">
                <summary class="flex items-center justify-between p-3.5 cursor-pointer select-none bg-base-200 hover:bg-base-300/60 transition-colors list-none">
                  <div class="flex items-center space-x-2">
                    <div class="p-1 bg-neutral-900 text-yellow-400 rounded-lg">
                      <%= svg_icon('sparkles', class: 'w-3.5 h-3.5 stroke-2') %>
                    </div>
                    <span class="font-bold text-xs uppercase tracking-wider text-base-content/80">AI System Prompt & Rules</span>
                    <span class="badge badge-xs font-mono text-[9px]" style="background-color: #18181b !important; color: #ffffff !important;">Gemini 3.6 Flash</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <span class="text-[11px] text-base-content/50 group-open:hidden">View Prompt</span>
                    <span class="text-[11px] text-base-content/50 hidden group-open:inline">Hide Prompt</span>
                    <div class="p-1 rounded-md bg-base-100/80 text-base-content/70 group-open:rotate-180 transition-transform duration-200">
                      <%= svg_icon('chevron_down', class: 'w-4 h-4 stroke-2') %>
                    </div>
                  </div>
                </summary>

                <div class="p-3.5 pt-2 border-t border-base-300 space-y-2.5">
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] text-base-content/80 font-medium">Instructions & extraction rules sent with every request:</span>
                    <button type="button" data-action="copy-prompt" id="copy_prompt_btn" class="btn btn-xs text-[10px] !rounded-lg gap-1 font-bold cursor-pointer shadow-xs" style="background-color: #18181b !important; color: #ffffff !important; border: 1px solid #18181b !important;">
                      <%= svg_icon('clipboard_copy', class: 'w-3 h-3 text-white') %>
                      <span id="copy_prompt_label" class="font-bold text-white" style="color: #ffffff !important;">Copy Prompt</span>
                    </button>
                  </div>
                  <pre id="system_prompt_pre" class="p-3 bg-neutral text-neutral-content text-[11px] font-mono rounded-xl overflow-x-auto max-h-72 leading-relaxed select-all whitespace-pre-wrap shadow-inner">You are an expert AI document processing assistant specializing in extracting structured RAW DATA from customer identity documents (e.g. Malaysian MyKad / Kad Pengenalan), calculator screenshots, device box labels (IMEI, Serial Number), and customer WhatsApp/order notes for equipment/phone rental agreements.

CRITICAL INSTRUCTION:
Extract ONLY RAW DATA fields (Customer Identity, Device Model, IMEI1, IMEI2, Serial Number, Deposit Amount, Monthly Rent, Product Price, Duration). DO NOT extract, calculate, or include PROCESSED fields (such as Order Number, Date fields, Nombor IMEI, or Jumlah Sewa) or Signatures.

RAW DATA EXTRACTION RULES:
1. Contact & Identity Information:
   - Customer / Recipient Full Name ("Nama", "Nama Penerima", "Pihak B", "Name"): Extract from MyKad IC photo or text notes.
   - IC / Identity Card Number ("No. Kad Pengenalan", "No. KP", "IC", "NRIC"): Extract from MyKad image (e.g. 890425-02-5957).
   - Phone Number ("Nombor Telefon", "No. Tel", "Mobile"): Extract from WhatsApp/order text.
   - Email Address ("E-mel", "Email"): Extract from WhatsApp/order text.
   - Address ("Alamat", "Alamat Penghantaran", "Address"): Extract full residential or delivery address.

2. Device & Product Information:
   - Product Name / Model ("Nama Produk", "Model", "Device Model"): Extract clean device model, capacity, and color from text or box image.
   - Primary IMEI ("IMEI1", "imei1", "IMEI", "IMEI / MEID"): Extract primary 15-digit IMEI. Always strip all spaces (e.g. "35 422867 725202 4" -> "354228677252024"). Do not extract 14-digit MEID, 32-digit EID, or UPC codes as IMEI.
   - Secondary IMEI ("IMEI2", "imei2"): Extract secondary 15-digit IMEI from box label or screen if present (strip spaces).
   - Serial Number ("Siri Telefon", "Serial No", "Serial", "SN"): Extract clean serial number stripping prefixes like "(S) Serial No." or "SN ".
   - Quantity ("Kuantiti Peralatan", "Quantity"): Usually "1".
   - Note: "Nombor IMEI" is system computed as "IMEI1 / IMEI2" (or "IMEI1 / -" if IMEI2 is missing).

3. Rental Pricing & Calculator Screenshots:
   - Selected Period ("calculator_period", "period"): Extract period from calculator UI (e.g. "13Period" -> "13").
   - Retail / Product Price ("Harga Produk", "Harga Pasaran", "Retail Price"): Extract pure numeric price.
   - Deposit Amount ("Deposit Produk", "Deposit Amount", "Deposit"): Extract pure numeric deposit.
   - Monthly Rent ("Harga Sewa Sebulan", "Monthly Rent", "Rent"): Extract monthly rental amount.
   - Note: "Jumlah Tempoh Sewaan" (Period - 1) and "Jumlah Sewa" (Rent * Duration) are system computed.

4. Response Format:
   - Valid JSON object containing "summary", "calculator_period", "submitters", and "fields" (including "imei1" and "imei2").</pre>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>


      <!-- Right Column: Data Upload & Inputs (7 cols) -->
      <div class="lg:col-span-7 space-y-4" id="ai_upload_section">
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-base-200">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-base-content/80">
                2. Input Data & Upload Documents
              </label>
              <p class="text-xs text-base-content/60 mt-0.5">
                Paste text/notes or upload IC photos, calculator screenshots, and box labels.
              </p>
            </div>
            <!-- Paste from Clipboard Button (Guaranteed Solid Dark Background & White Text) -->
            <button type="button" id="paste_clipboard_btn" onclick="pasteFromClipboard()" style="background-color: #18181b !important; color: #ffffff !important; border: 1px solid #18181b !important; display: inline-flex !important; align-items: center !important;" class="btn btn-sm gap-2 text-xs !rounded-xl shadow-sm hover:opacity-90 transition-all flex-shrink-0 font-semibold cursor-pointer px-3.5 !h-9">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              <span id="paste_clipboard_label" style="color: #ffffff !important; font-weight: 600 !important;">Paste from Clipboard</span>
            </button>
          </div>

          <!-- Text / Notes Input -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="ai_text_input" class="text-xs font-bold text-base-content/80">
                Paste Text, WhatsApp Message or Order Notes
              </label>
              <span class="text-[11px] text-base-content/50">Optional</span>
            </div>
            <textarea id="ai_text_input" name="text" rows="5" class="textarea textarea-bordered textarea-sm w-full text-xs rounded-xl focus:border-neutral-900 font-mono" placeholder="Paste customer WhatsApp message, order notes, email, calculator details, or instructions here..."></textarea>
          </div>

          <!-- File Dropzone for Pictures & PDFs (Clickable Dropzone & Button) -->
          <div>
            <label class="block text-xs font-bold text-base-content/80 mb-1">
              Upload Images & PDF Documents
            </label>
            <input type="file" id="ai_file_input" multiple accept=".pdf,application/pdf,image/*,.png,.jpg,.jpeg,.webp" style="display: none !important;" onchange="window.handleFileSelect && window.handleFileSelect(this.files)">
            <div id="ai_file_dropzone" data-action="open-file-dialog" role="button" tabindex="0" class="border-2 border-dashed border-neutral-400 hover:border-neutral-900 bg-base-200/50 hover:bg-base-200 rounded-2xl p-6 text-center cursor-pointer transition-all flex flex-col items-center justify-center space-y-3 select-none">
              <div class="p-3.5 rounded-2xl shadow-2xs flex items-center justify-center pointer-events-none" style="background-color: #f4f4f5 !important; border: 1px solid #e4e4e7 !important;">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" style="color: #18181b !important; stroke: #18181b !important;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <div class="pointer-events-none text-center">
                <div class="text-xs font-bold text-neutral-900">
                  <span class="underline">Click anywhere to browse files</span>
                  <span class="text-base-content/70 font-normal"> or drag & drop here</span>
                </div>
                <p class="text-[11px] text-base-content/60 mt-1">Supports PDF, PNG, JPG, JPEG, WEBP (MyKad IC, calculator screenshots, IMEI labels)</p>
              </div>
              <button type="button" data-action="open-file-dialog" class="btn btn-xs !rounded-lg text-xs font-semibold px-4 cursor-pointer" style="background-color: #18181b !important; color: #ffffff !important; border: 1px solid #18181b !important;">
                Browse Files
              </button>
            </div>

            <!-- Selected Files List -->
            <div id="ai_selected_files_list" class="mt-3 space-y-2 hidden">
              <div class="text-xs font-semibold text-base-content/80 flex items-center justify-between">
                <span class="flex items-center space-x-1.5">
                  <span>Selected Documents (<span id="ai_file_count" class="font-bold text-neutral-900">0</span>)</span>
                </span>
                <button type="button" id="ai_clear_files_btn" data-action="clear-files" class="text-error hover:underline text-[11px] font-medium cursor-pointer">Clear all</button>
              </div>
              <div id="ai_files_badge_container" class="space-y-1.5 max-h-48 overflow-y-auto pr-1"></div>
            </div>
          </div>

          <!-- Extract Button & Error Alert -->
          <div id="ai_extract_error" class="hidden text-xs p-3.5 rounded-xl font-bold shadow-md flex items-center space-x-2.5" style="background-color: #dc2626 !important; color: #ffffff !important; border: 1px solid #b91c1c !important;"></div>

          <div class="pt-3 flex justify-end">
            <button type="button" id="ai_extract_btn" data-action="extract-ai" class="btn btn-neutral !bg-neutral-900 hover:!bg-black !text-white text-xs px-8 shadow-sm hover:shadow-md transition-all gap-2 !rounded-xl !h-11 cursor-pointer">
              <%= svg_icon('sparkles', class: 'w-4 h-4 stroke-2 text-yellow-400') %>
              <span id="ai_extract_btn_text" class="font-bold text-sm text-white">Extract with AI & Populate Fields</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- AI Loading State -->
    <div id="ai_loading_state" class="hidden card bg-base-100 border border-base-300 rounded-2xl p-12 text-center space-y-4 shadow-sm">
      <div class="flex justify-center">
        <div class="p-4 bg-neutral-900 rounded-2xl text-yellow-400 shadow-md animate-pulse">
          <%= svg_icon('sparkles', class: 'w-10 h-10 stroke-2 animate-spin') %>
        </div>
      </div>
      <div class="text-lg font-bold text-base-content">Analyzing Documents & Extracting Fields...</div>
    </div>

    <!-- Step 3: Extracted Results Container -->
    <div id="ai_extraction_results" class="hidden"></div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  window.togglePromptAndFields = function() {
    const detailsSection = document.getElementById('ai_template_prompt_details');
    const iconHidden = document.getElementById('icon_hidden_state');
    const iconShown = document.getElementById('icon_shown_state');
    const btn = document.getElementById('toggle_prompt_fields_btn');

    if (!detailsSection) return;

    const isHidden = detailsSection.classList.contains('hidden');
    if (isHidden) {
      detailsSection.classList.remove('hidden');
      if (iconHidden) iconHidden.classList.add('hidden');
      if (iconShown) iconShown.classList.remove('hidden');
      if (btn) btn.setAttribute('title', 'Hide Template Fields & AI System Prompt');
    } else {
      detailsSection.classList.add('hidden');
      if (iconHidden) iconHidden.classList.remove('hidden');
      if (iconShown) iconShown.classList.add('hidden');
      if (btn) btn.setAttribute('title', 'Show Template Fields & AI System Prompt');
    }
  };

  window.aiSelectedFiles = window.aiSelectedFiles || [];

  window.recalculateJumlahSewa = function() {
    const hsInput = document.querySelector('input[data-field-name="Harga Sewa Sebulan"]');
    const jtInput = document.querySelector('input[data-field-name="Jumlah Tempoh Sewaan"], input[data-field-name="Tempoh Sewaan"]');
    const jsInput = document.querySelector('input[data-field-name="Jumlah Sewa"], input[data-field-name="Jumlah Sewaan"]');
    const tmInput = document.querySelector('input[data-field-name="Tarikh mula sewaan"], input[data-field-name="Tarikh Mula Sewaan"]');
    const taInput = document.querySelector('input[data-field-name="Tarikh akhir sewaan"], input[data-field-name="Tarikh Akhir Sewaan"]');

    const jt = jtInput ? parseFloat(jtInput.value.replace(/[^0-9.]/g, '')) || 0 : 0;

    if (hsInput && jsInput) {
      const hs = parseFloat(hsInput.value.replace(/[^0-9.]/g, '')) || 0;
      if (hs > 0 && jt > 0) {
        const total = hs * jt;
        jsInput.value = (total % 1 === 0) ? total.toString() : total.toFixed(2);
      }
    }

    if (taInput && jt > 0) {
      let baseDate = new Date();
      if (tmInput && tmInput.value) {
        const parts = tmInput.value.split('-');
        if (parts.length === 3) {
          if (parts[0].length === 4) {
            baseDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
          } else {
            baseDate = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
          }
        }
      }
      if (!isNaN(baseDate.getTime())) {
        baseDate.setMonth(baseDate.getMonth() + jt);
        const d = String(baseDate.getDate()).padStart(2, '0');
        const m = String(baseDate.getMonth() + 1).padStart(2, '0');
        const y = baseDate.getFullYear();
        taInput.value = `${d}-${m}-${y}`;
      }
    }
  };

  window.recalculateNomborImei = function() {
    const imei1Input = document.querySelector('input[data-field-name="IMEI1"], input[name*="[imei1]"]');
    const imei2Input = document.querySelector('input[data-field-name="IMEI2"], input[name*="[imei2]"]');
    const niInput = document.querySelector('input[data-field-name="Nombor IMEI"], input[data-field-name="Nombor IMEI Telefon"]');

    if (niInput) {
      const v1 = imei1Input ? imei1Input.value.replace(/[^0-9]/g, '').trim() : '';
      const v2 = imei2Input ? imei2Input.value.replace(/[^0-9]/g, '').trim() : '';

      if (v1 && v2) {
        niInput.value = `${v1} / ${v2}`;
      } else if (v1) {
        niInput.value = `${v1} / -`;
      } else if (v2) {
        niInput.value = `- / ${v2}`;
      }
    }
  };

  window.selectTemplateBtn = function(templateId) {
    const hiddenInput = document.getElementById('ai_template_select');
    if (hiddenInput) {
      hiddenInput.value = templateId;
    }

    const buttons = document.querySelectorAll('.template-option-btn');
    buttons.forEach(btn => {
      const isThis = (btn.dataset.templateId == templateId);
      const iconBox = btn.querySelector('.icon-box');
      const nameEl = btn.querySelector('.tmpl-name');
      const descEl = btn.querySelector('.tmpl-desc');
      const checkBadge = btn.querySelector('.check-badge');

      if (isThis) {
        btn.setAttribute('style', 'background-color: #18181b !important; color: #ffffff !important; border: 2px solid #2563eb !important; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15) !important;');
        if (iconBox) iconBox.setAttribute('style', 'background-color: #27272a !important; color: #facc15 !important;');
        if (nameEl) nameEl.setAttribute('style', 'color: #ffffff !important; font-weight: 700 !important;');
        if (descEl) descEl.setAttribute('style', 'color: #d4d4d8 !important; font-weight: 500 !important;');
        if (checkBadge) checkBadge.setAttribute('style', 'display: inline-flex !important; align-items: center !important; gap: 4px !important; background-color: #2563eb !important; color: #ffffff !important; font-weight: 700 !important; font-size: 11px !important; padding: 4px 10px !important; border-radius: 8px !important;');
      } else {
        btn.setAttribute('style', 'background-color: #ffffff !important; color: #18181b !important; border: 1.5px solid #e4e4e7 !important; box-shadow: none !important;');
        if (iconBox) iconBox.setAttribute('style', 'background-color: #f4f4f5 !important; color: #52525b !important;');
        if (nameEl) nameEl.setAttribute('style', 'color: #18181b !important; font-weight: 700 !important;');
        if (descEl) descEl.setAttribute('style', 'color: #71717a !important; font-weight: 500 !important;');
        if (checkBadge) checkBadge.setAttribute('style', 'display: none !important;');
      }
    });

    window.onTemplateChange(templateId);
  };

  window.onTemplateChange = function(templateId) {
    if (!templateId) return;
    const container = document.getElementById('template_fields_container');
    if (!container) return;
    container.innerHTML = '<div class="text-xs text-base-content/50 py-3 text-center animate-pulse">Loading template fields...</div>';

    fetch(`/ai_submissions/template_fields?template_id=${templateId}`, {
      headers: { 'Accept': 'text/html' }
    })
    .then(res => res.text())
    .then(html => {
      container.innerHTML = html;
    })
    .catch(err => {
      container.innerHTML = `<div class="text-xs text-error py-2">Failed to load fields: ${err.message}</div>`;
    });
  };

  window.openAiFileDialog = function() {
    const fileInput = document.getElementById('ai_file_input');
    if (fileInput) fileInput.click();
  };

  window.handleFileSelect = function(files) {
    if (!files || files.length === 0) return;
    const fileList = Array.from(files);
    if (!Array.isArray(window.aiSelectedFiles)) {
      window.aiSelectedFiles = [];
    }

    fileList.forEach(f => {
      const exists = window.aiSelectedFiles.some(existing => existing.name === f.name && existing.size === f.size);
      if (!exists) {
        window.aiSelectedFiles.push(f);
      }
    });

    const fileInput = document.getElementById('ai_file_input');
    if (fileInput) fileInput.value = '';

    window.renderSelectedFiles();
  };

  window.removeSelectedFile = function(idx) {
    if (!Array.isArray(window.aiSelectedFiles)) return;
    window.aiSelectedFiles.splice(idx, 1);
    const fileInput = document.getElementById('ai_file_input');
    if (fileInput) fileInput.value = '';
    window.renderSelectedFiles();
  };

  window.clearSelectedFiles = function() {
    window.aiSelectedFiles = [];
    const fileInput = document.getElementById('ai_file_input');
    if (fileInput) fileInput.value = '';
    window.renderSelectedFiles();
  };

  window.renderSelectedFiles = function() {
    const container = document.getElementById('ai_files_badge_container');
    const listWrapper = document.getElementById('ai_selected_files_list');
    const countSpan = document.getElementById('ai_file_count');
    const dropzone = document.getElementById('ai_file_dropzone');
    if (!container || !listWrapper || !countSpan) return;

    if (!Array.isArray(window.aiSelectedFiles) || window.aiSelectedFiles.length === 0) {
      listWrapper.classList.add('hidden');
      listWrapper.style.setProperty('display', 'none', 'important');
      container.innerHTML = '';
      if (dropzone) {
        dropzone.classList.remove('border-emerald-600', 'bg-emerald-500/5');
      }
      return;
    }

    listWrapper.classList.remove('hidden');
    listWrapper.style.setProperty('display', 'block', 'important');
    countSpan.textContent = window.aiSelectedFiles.length;
    container.innerHTML = '';

    if (dropzone) {
      dropzone.classList.add('border-emerald-600', 'bg-emerald-500/5');
    }

    window.aiSelectedFiles.forEach((file, idx) => {
      const item = document.createElement('div');
      item.className = 'flex items-center justify-between p-2.5 bg-base-200/90 hover:bg-base-200 rounded-xl text-xs border border-base-300 transition-colors shadow-2xs';
      const isPdf = file.name.toLowerCase().endsWith('.pdf') || (file.type && file.type.includes('pdf'));
      const isImg = !isPdf && (file.type ? file.type.startsWith('image/') : file.name.match(/\.(png|jpe?g|webp|gif|bmp)$/i));
      const sizeKb = (file.size / 1024).toFixed(1);

      let previewHtml = '';
      if (isImg) {
        try {
          const objectUrl = URL.createObjectURL(file);
          previewHtml = `<img src="${objectUrl}" alt="" class="w-9 h-9 rounded-lg object-cover border border-base-300 shadow-2xs flex-shrink-0">`;
        } catch (e) {
          previewHtml = `<div class="w-9 h-9 rounded-lg bg-base-300 text-base-content font-bold text-[10px] flex items-center justify-center flex-shrink-0">IMG</div>`;
        }
      } else if (isPdf) {
        previewHtml = `<div class="w-9 h-9 rounded-lg bg-red-100 text-red-700 font-bold text-[10px] flex items-center justify-center border border-red-200 flex-shrink-0">PDF</div>`;
      } else {
        previewHtml = `<div class="w-9 h-9 rounded-lg bg-neutral-200 text-neutral-800 font-bold text-[10px] flex items-center justify-center flex-shrink-0">FILE</div>`;
      }

      const infoDiv = document.createElement('div');
      infoDiv.className = 'flex items-center space-x-3 min-w-0 truncate';
      infoDiv.innerHTML = `
        ${previewHtml}
        <div class="min-w-0 truncate">
          <div class="font-bold text-base-content truncate">${file.name}</div>
          <div class="text-[10px] text-base-content/60 font-mono">${sizeKb} KB &bull; Ready to process</div>
        </div>
      `;

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.dataset.action = 'remove-file';
      removeBtn.dataset.index = idx;
      removeBtn.className = 'btn btn-ghost btn-xs text-error hover:bg-error/15 px-2.5 rounded-lg cursor-pointer font-bold ml-2 flex-shrink-0';
      removeBtn.title = 'Remove file';
      removeBtn.textContent = '✕';

      item.appendChild(infoDiv);
      item.appendChild(removeBtn);
      container.appendChild(item);
    });
  };

  window.attachAiFilesAndNotesToForm = function(form) {
    if (!form) return;
    try {
      if (window.aiSelectedFiles && window.aiSelectedFiles.length > 0) {
        const fileInput = form.querySelector('#ai_submission_files_input') || form.querySelector('input[name="files[]"]');
        if (fileInput && typeof DataTransfer !== 'undefined') {
          const dt = new DataTransfer();
          window.aiSelectedFiles.forEach(f => dt.items.add(f));
          fileInput.files = dt.files;
        }
      }
      const textInput = document.getElementById('ai_text_input');
      if (textInput && textInput.value) {
        let notesInput = form.querySelector('input[name="ai_text_notes"]');
        if (!notesInput) {
          notesInput = document.createElement('input');
          notesInput.type = 'hidden';
          notesInput.name = 'ai_text_notes';
          form.appendChild(notesInput);
        }
        notesInput.value = textInput.value;
      }
    } catch (err) {
      console.warn('Could not attach files/notes to form:', err);
    }
  };

  // Paste from Clipboard functionality (Supports Text, Images, and PDF Files)
  window.pasteFromClipboard = async function() {
    const label = document.getElementById('paste_clipboard_label');
    const textarea = document.getElementById('ai_text_input');

    try {
      let pastedSomething = false;

      // 1. Try reading rich clipboard items (images, PDFs, blobs)
      if (navigator.clipboard && navigator.clipboard.read) {
        try {
          const items = await navigator.clipboard.read();
          for (const item of items) {
            for (const type of item.types) {
              if (type.startsWith('image/') || type.includes('pdf') || type === 'application/pdf') {
                const blob = await item.getType(type);
                const isPdf = type.includes('pdf') || type === 'application/pdf';
                const ext = isPdf ? 'pdf' : (type.split('/')[1] || 'png');
                const file = new File([blob], `pasted_document_${Date.now()}.${ext}`, { type: isPdf ? 'application/pdf' : type });
                window.aiSelectedFiles.push(file);
                pastedSomething = true;
              }
            }
          }
        } catch (e) {
          console.warn('Rich clipboard read not permitted or empty:', e);
        }
      }

      // 2. Try reading text from clipboard
      if (navigator.clipboard && navigator.clipboard.readText) {
        try {
          const text = await navigator.clipboard.readText();
          if (text && text.trim().length > 0) {
            if (textarea) {
              if (textarea.value && textarea.value.trim().length > 0) {
                textarea.value += '\n' + text.trim();
              } else {
                textarea.value = text.trim();
              }
            }
            pastedSomething = true;
          }
        } catch (e) {
          console.warn('Text clipboard read not permitted:', e);
        }
      }

      if (pastedSomething) {
        window.renderSelectedFiles();
        if (label) {
          label.textContent = 'Pasted successfully!';
          setTimeout(() => { label.textContent = 'Paste from Clipboard'; }, 2000);
        }
      } else {
        if (label) {
          label.textContent = 'Clipboard is empty or unsupported';
          setTimeout(() => { label.textContent = 'Paste from Clipboard'; }, 2500);
        }
      }
    } catch (err) {
      if (label) {
        label.textContent = 'Paste failed: ' + err.message;
        setTimeout(() => { label.textContent = 'Paste from Clipboard'; }, 2500);
      }
    }
  };

  window.startAiExtraction = function() {
    const templateSelect = document.getElementById('ai_template_select');
    const templateId = templateSelect ? templateSelect.value : null;
    const textInput = document.getElementById('ai_text_input');
    const text = textInput ? textInput.value.trim() : '';
    const errorDiv = document.getElementById('ai_extract_error');
    const uploadSection = document.getElementById('ai_setup_grid');
    const loadingState = document.getElementById('ai_loading_state');
    const resultsContainer = document.getElementById('ai_extraction_results');

    if (errorDiv) {
      errorDiv.classList.add('hidden');
      errorDiv.textContent = '';
    }

    if (!templateId) {
      if (errorDiv) {
        errorDiv.textContent = 'Please select a document template.';
        errorDiv.classList.remove('hidden');
      }
      return;
    }

    if (!text && window.aiSelectedFiles.length === 0) {
      if (errorDiv) {
        errorDiv.textContent = 'Please provide some text or upload at least one image or PDF document.';
        errorDiv.classList.remove('hidden');
      }
      return;
    }

    const formData = new FormData();
    formData.append('template_id', templateId);
    formData.append('text', text);

    window.aiSelectedFiles.forEach(file => {
      formData.append('files[]', file);
    });

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

    if (uploadSection) uploadSection.classList.add('hidden');
    if (loadingState) loadingState.classList.remove('hidden');
    if (resultsContainer) resultsContainer.classList.add('hidden');

    fetch('/ai_submissions/extract', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': csrfToken || '',
        'Accept': 'text/html'
      },
      body: formData
    })
    .then(async (res) => {
      if (!res.ok) {
        const errData = await res.json().catch(() => ({ error: 'Extraction failed.' }));
        throw new Error(errData.error || `Error ${res.status}: ${res.statusText}`);
      }
      return res.text();
    })
    .then(html => {
      if (loadingState) loadingState.classList.add('hidden');
      if (resultsContainer) {
        resultsContainer.innerHTML = html;
        resultsContainer.classList.remove('hidden');
      }
    })
    .catch(err => {
      if (loadingState) loadingState.classList.add('hidden');
      if (uploadSection) uploadSection.classList.remove('hidden');
      if (errorDiv) {
        errorDiv.textContent = err.message || 'An unexpected error occurred during AI extraction.';
        errorDiv.classList.remove('hidden');
      }
    });
  };

  window.switchAiTab = function(tabName) {
    const formTab = document.getElementById('ai_tab_form');
    const jsonTab = document.getElementById('ai_tab_json');
    const formBtn = document.getElementById('tab_btn_form');
    const jsonBtn = document.getElementById('tab_btn_json');
    if (!formTab || !jsonTab) return;

    if (tabName === 'form') {
      formTab.classList.remove('hidden');
      jsonTab.classList.add('hidden');
      if (formBtn) formBtn.className = 'py-2.5 px-4 text-xs font-bold border-b-2 border-neutral-900 text-neutral-900 transition-colors';
      if (jsonBtn) jsonBtn.className = 'py-2.5 px-4 text-xs font-semibold border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-colors flex items-center space-x-1';
    } else {
      formTab.classList.add('hidden');
      jsonTab.classList.remove('hidden');
      if (jsonBtn) jsonBtn.className = 'py-2.5 px-4 text-xs font-bold border-b-2 border-neutral-900 text-neutral-900 transition-colors flex items-center space-x-1';
      if (formBtn) formBtn.className = 'py-2.5 px-4 text-xs font-semibold border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-colors';
    }
  };

  window.copyExtractedJson = function() {
    const pre = document.getElementById('extracted_json_pre');
    const label = document.getElementById('copy_json_label');
    if (pre) {
      navigator.clipboard.writeText(pre.innerText).then(() => {
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Copy JSON'; }, 2000);
        }
      });
    }
  };

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  window.showAiFormValidationError = function(msg) {
    const alertEl = document.getElementById('ai_form_validation_alert');
    const alertText = document.getElementById('ai_form_validation_alert_text');
    if (alertEl && alertText) {
      alertText.textContent = msg;
      alertEl.classList.remove('hidden');
      alertEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  window.showMissingFieldsConfirmationModal = function(form, missingList, firstInput) {
    const modal = document.getElementById('ai_missing_fields_modal');
    const msgEl = document.getElementById('ai_missing_fields_message');
    const backBtn = document.getElementById('ai_missing_fields_back_btn');
    const continueBtn = document.getElementById('ai_missing_fields_continue_btn');

    if (!modal || !msgEl) {
      if (confirm(`${missingList.join(', ')} fields are missing. Do you wish to continue?`)) {
        form.dataset.confirmedSubmit = 'true';
        form.submit();
      }
      return;
    }

    let promptMsg = '';
    if (missingList.length === 1) {
      promptMsg = `<span class="font-bold text-neutral-900">"${escapeHtml(missingList[0])}"</span> is not populated. Do you wish to continue?`;
    } else if (missingList.length === 2) {
      promptMsg = `<span class="font-bold text-neutral-900">"${escapeHtml(missingList[0])}"</span> and <span class="font-bold text-neutral-900">"${escapeHtml(missingList[1])}"</span> are not populated. Do you wish to continue?`;
    } else {
      const copy = [...missingList];
      const last = copy.pop();
      const boldList = copy.map(item => `<span class="font-bold text-neutral-900">"${escapeHtml(item)}"</span>`).join(', ');
      promptMsg = `${boldList}, and <span class="font-bold text-neutral-900">"${escapeHtml(last)}"</span> are not populated. Do you wish to continue?`;
    }

    msgEl.innerHTML = promptMsg;

    const handleBack = function(ev) {
      if (ev) ev.preventDefault();
      cleanup();
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.classList.remove('modal-open');
      }
      if (firstInput) {
        setTimeout(() => {
          firstInput.focus();
          firstInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
      }
    };

    const handleContinue = function(ev) {
      if (ev) ev.preventDefault();
      cleanup();
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.classList.remove('modal-open');
      }
      if (window.attachAiFilesAndNotesToForm) {
        window.attachAiFilesAndNotesToForm(form);
      }
      form.dataset.confirmedSubmit = 'true';
      form.submit();
    };

    const cleanup = function() {
      if (backBtn) backBtn.removeEventListener('click', handleBack);
      if (continueBtn) continueBtn.removeEventListener('click', handleContinue);
    };

    if (backBtn) backBtn.addEventListener('click', handleBack);
    if (continueBtn) continueBtn.addEventListener('click', handleContinue);

    if (typeof modal.showModal === 'function') {
      modal.showModal();
    } else {
      modal.classList.add('modal-open');
    }
  };

  // Attach global document listeners once across Turbo lifecycle
  if (!window.__aiWizardListenersAttached) {
    window.__aiWizardListenersAttached = true;

    // 1. Form submit handler: Frontend validation for REQUIRED fields first + confirmation for OPTIONAL unpopulated fields
    document.addEventListener('submit', function(e) {
      const form = e.target;
      if (form && form.id === 'ai_create_submission_form') {
        if (form.dataset.confirmedSubmit === 'true') {
          return;
        }

        const alertEl = document.getElementById('ai_form_validation_alert');
        if (alertEl) alertEl.classList.add('hidden');

        // Step 1: Validate all REQUIRED fields
        const requiredInputs = form.querySelectorAll('input[required], textarea[required], select[required], [data-required-field="true"]');
        const missingRequired = [];
        let firstInvalidInput = null;

        requiredInputs.forEach(input => {
          if (input.type === 'hidden' || input.type === 'submit') return;

          let isInvalid = false;
          const val = input.value ? input.value.trim() : '';

          if (input.type === 'checkbox') {
            if (!input.checked) isInvalid = true;
          } else if (input.type === 'email') {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!val || !emailRegex.test(val)) isInvalid = true;
          } else {
            if (!val) isInvalid = true;
          }

          if (isInvalid) {
            const fieldName = input.dataset.fieldName || input.name;
            if (!missingRequired.includes(fieldName)) {
              missingRequired.push(fieldName);
            }
            if (!firstInvalidInput) {
              firstInvalidInput = input;
            }
            input.classList.add('input-error', '!border-error');
          } else {
            input.classList.remove('input-error', '!border-error');
          }
        });

        // If ANY REQUIRED field is missing or invalid, block submission and prompt user to complete it
        if (missingRequired.length > 0) {
          e.preventDefault();
          if (firstInvalidInput) {
            firstInvalidInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            firstInvalidInput.focus();
            if (typeof firstInvalidInput.reportValidity === 'function') {
              firstInvalidInput.reportValidity();
            }
          }
          window.showAiFormValidationError(`Please complete all required fields (${missingRequired.join(', ')}) before submitting.`);
          return;
        }

        // Step 2: All required fields are valid. Check for unpopulated OPTIONAL fields
        const allInputs = form.querySelectorAll('input[data-field-name], textarea[data-field-name], select[data-field-name]');
        const optionalMissing = [];
        let firstOptionalInput = null;

        allInputs.forEach(input => {
          if (input.type === 'hidden' || input.type === 'checkbox' || input.type === 'submit') return;
          if (input.hasAttribute('required') || input.dataset.requiredField === 'true') return;

          const val = input.value ? input.value.trim() : '';
          if (!val) {
            const fieldName = input.dataset.fieldName;
            if (fieldName && !optionalMissing.includes(fieldName)) {
              optionalMissing.push(fieldName);
            }
            if (!firstOptionalInput) {
              firstOptionalInput = input;
            }
          }
        });

        // If any optional fields are missing, display the confirmation prompt
        if (optionalMissing.length > 0) {
          e.preventDefault();
          window.showMissingFieldsConfirmationModal(form, optionalMissing, firstOptionalInput);
          return;
        }

        // Step 3: All fields (required and optional) are populated -> Submit immediately
        if (window.attachAiFilesAndNotesToForm) {
          window.attachAiFilesAndNotesToForm(form);
        }
      }
    });

    // 2. Clear visual validation error highlights when user types
    document.addEventListener('input', function(e) {
      const input = e.target;
      if (input && (input.classList.contains('input-error') || input.classList.contains('!border-error'))) {
        if (input.value && input.value.trim()) {
          input.classList.remove('input-error', '!border-error');
          const alertEl = document.getElementById('ai_form_validation_alert');
          if (alertEl) alertEl.classList.add('hidden');
        }
      }
    });

    // 3. Global Paste (Ctrl+V / Cmd+V) for images, PDFs, and text
    document.addEventListener('paste', function(e) {
      const wizard = document.getElementById('ai_submission_wizard');
      if (!wizard) return;

      const clipboardData = e.clipboardData || e.originalEvent?.clipboardData;
      if (!clipboardData) return;

      let addedFile = false;

      // Check direct file list
      const files = clipboardData.files;
      if (files && files.length > 0) {
        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          const isPdf = file.name.toLowerCase().endsWith('.pdf') || file.type.includes('pdf');
          const isImg = file.type.startsWith('image/') || file.name.toLowerCase().match(/\.(png|jpe?g|webp|gif|bmp)$/);
          if (isPdf || isImg) {
            window.aiSelectedFiles.push(file);
            addedFile = true;
          }
        }
      }

      // Check clipboard items
      if (!addedFile) {
        const items = clipboardData.items;
        if (items && items.length > 0) {
          for (let i = 0; i < items.length; i++) {
            const item = items[i];
            if (item.kind === 'file') {
              const file = item.getAsFile();
              if (file) {
                const isPdf = file.name.toLowerCase().endsWith('.pdf') || file.type.includes('pdf') || item.type.includes('pdf');
                const isImg = file.type.startsWith('image/') || item.type.startsWith('image/');
                if (isPdf || isImg) {
                  window.aiSelectedFiles.push(file);
                  addedFile = true;
                }
              }
            }
          }
        }
      }

      if (addedFile) {
        e.preventDefault();
        window.renderSelectedFiles();
        return;
      }

      // Plain text paste outside textarea
      const activeEl = document.activeElement;
      const textarea = document.getElementById('ai_text_input');
      if (textarea && activeEl !== textarea && activeEl?.tagName !== 'INPUT' && activeEl?.tagName !== 'TEXTAREA') {
        const text = clipboardData.getData('text');
        if (text && text.trim().length > 0) {
          e.preventDefault();
          if (textarea.value && textarea.value.trim().length > 0) {
            textarea.value += '\n' + text.trim();
          } else {
            textarea.value = text.trim();
          }
          textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });

    // 2. Centralized click delegator for all wizard actions
    document.addEventListener('click', function(e) {
      const wizard = document.getElementById('ai_submission_wizard');
      if (!wizard) return;

      const target = e.target.closest('[data-action], #reupload_btn, #tab_btn_form, #tab_btn_json, #copy_json_btn, #paste_clipboard_btn, #ai_extract_btn, #ai_clear_files_btn, #copy_prompt_btn, #ai_file_dropzone');
      if (!target) return;

      const action = target.dataset.action;
      const id = target.id;

      if (action === 'open-file-dialog' || id === 'ai_file_dropzone') {
        e.preventDefault();
        window.openAiFileDialog();
      } else if (action === 'reupload' || id === 'reupload_btn') {
        e.preventDefault();
        const resultsContainer = document.getElementById('ai_extraction_results');
        const uploadSection = document.getElementById('ai_setup_grid');
        if (resultsContainer) resultsContainer.classList.add('hidden');
        if (uploadSection) uploadSection.classList.remove('hidden');
      } else if (action === 'switch-tab-form' || id === 'tab_btn_form') {
        e.preventDefault();
        window.switchAiTab('form');
      } else if (action === 'switch-tab-json' || id === 'tab_btn_json') {
        e.preventDefault();
        window.switchAiTab('json');
      } else if (action === 'copy-json' || id === 'copy_json_btn') {
        e.preventDefault();
        window.copyExtractedJson();
      } else if (action === 'paste-clipboard' || id === 'paste_clipboard_btn') {
        e.preventDefault();
        window.pasteFromClipboard();
      } else if (action === 'extract-ai' || id === 'ai_extract_btn') {
        e.preventDefault();
        window.startAiExtraction();
      } else if (action === 'clear-files' || id === 'ai_clear_files_btn') {
        e.preventDefault();
        window.clearSelectedFiles();
      } else if (action === 'remove-file') {
        e.preventDefault();
        const idx = parseInt(target.dataset.index, 10);
        if (!isNaN(idx)) {
          window.removeSelectedFile(idx);
        }
      } else if (action === 'select-template') {
        e.preventDefault();
        const templateId = target.dataset.templateId;
        if (templateId) {
          window.selectTemplateBtn(templateId);
        }
      } else if (action === 'copy-prompt' || id === 'copy_prompt_btn') {
        e.preventDefault();
        const promptPre = document.getElementById('system_prompt_pre');
        const promptLabel = document.getElementById('copy_prompt_label');
        if (promptPre) {
          navigator.clipboard.writeText(promptPre.innerText).then(() => {
            if (promptLabel) {
              promptLabel.textContent = 'Copied!';
              setTimeout(() => { promptLabel.textContent = 'Copy Prompt'; }, 2000);
            }
          });
        }
      }
    });

    // Keyboard trigger (Enter/Space) for dropzone
    document.addEventListener('keydown', function(e) {
      if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.id === 'ai_file_dropzone') {
        e.preventDefault();
        window.openAiFileDialog();
      }
    });
  }

  // Idempotent page-level initialization (Dropzone drag&drop, file rendering)
  window.initAiSubmissionPage = function() {
    window.renderSelectedFiles();

    const fileInput = document.getElementById('ai_file_input');
    if (fileInput && !fileInput.dataset.bound) {
      fileInput.dataset.bound = 'true';
      fileInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
          window.handleFileSelect(this.files);
        }
      });
    }

    const dropzone = document.getElementById('ai_file_dropzone');
    const wizardCard = document.getElementById('ai_setup_grid');

    if (dropzone && !dropzone.dataset.dragBound) {
      dropzone.dataset.dragBound = 'true';

      [dropzone, wizardCard].filter(Boolean).forEach(el => {
        ['dragenter', 'dragover'].forEach(eventName => {
          el.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (dropzone) dropzone.classList.add('border-neutral-900', 'bg-base-200');
          }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
          el.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (dropzone) dropzone.classList.remove('border-neutral-900', 'bg-base-200');
          }, false);
        });

        el.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const dt = e.dataTransfer;
          const files = dt ? dt.files : null;
          if (files && files.length > 0) {
            window.handleFileSelect(files);
          }
        }, false);
      });
    }
  };

  // Run on initial load and turbo events
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.initAiSubmissionPage);
  } else {
    window.initAiSubmissionPage();
  }
  document.addEventListener('turbo:load', window.initAiSubmissionPage);
  document.addEventListener('turbo:render', window.initAiSubmissionPage);
</script>


