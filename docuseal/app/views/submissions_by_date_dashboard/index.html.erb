<% filter_params = params.permit(Submissions::Filter::ALLOWED_PARAMS).compact_blank %>
<% is_show_tabs = true %>
<% if Docuseal.demo? %><%= render 'shared/demo_alert' %><% end %>
<div class="group/header flex justify-between items-center w-full mb-4">
  <div class="flex items-center flex-grow min-w-0 max-md:group-has-[search-input:focus-within]/header:hidden <%= 'max-md:hidden' if params[:q].present? %>">
    <div class="mr-2">
      <%= render 'dashboard/toggle_view', selected: 'submissions_by_date' %>
    </div>
    <h1 class="text-2xl truncate md:text-3xl sm:text-4xl font-bold md:block <%= 'hidden' if params[:q].present? %>">
      <%= t('submissions_by_date', default: 'Submissions by date') %>
    </h1>
  </div>
  <div class="flex space-x-2 max-md:has-[search-input:focus-within]:grow <%= 'max-md:grow' if params[:q].present? %>">
    <% if params[:q].present? || @pagy.pages > 1 || filter_params.present? %>
      <%= render 'shared/search_input' %>
    <% end %>
    <% if can?(:create, Submission) %>
      <%= link_to new_ai_submission_path, id: 'create_ai_submission_button', data: { turbo: false }, class: 'btn btn-neutral gap-2 !bg-neutral-900 hover:!bg-black !text-white !border-neutral-900 shadow-sm hover:shadow-md transition-all !h-10 !min-h-[40px] px-3.5 !rounded-xl flex items-center' do %>
        <%= svg_icon('sparkles', class: 'w-5 h-5 stroke-2 text-yellow-400') %>
        <span class="font-semibold text-sm tracking-wide text-white"><%= t('create_with_ai', default: 'Create with AI') %></span>
      <% end %>
    <% end %>

    <% if can?(:create, ::Template) %>
      <span class="hidden sm:block">
        <%= render 'templates/upload_button' %>
      </span>
      <open-modal-mobile data-disabled="<%= !Docuseal.multitenant? %>" class="flex">
        <%= link_to new_template_path, class: 'white-button !border gap-2', data: { turbo_frame: :modal } do %>
          <%= svg_icon('plus', class: 'w-6 h-6 stroke-2') %>
          <span class="hidden md:block"><%= t('create') %></span>
        <% end %>
      </open-modal-mobile>
    <% end %>
  </div>
</div>
<% view_archived_html = capture do %>
  <% if can?(:manage, :countless) || current_account.submissions.where.not(archived_at: nil).exists? %>
    <div>
      <a href="<%= submissions_archived_index_path %>" class="link text-sm"><%= t('view_archived') %></a>
    </div>
  <% end %>
<% end %>
<% if is_show_tabs %>
  <div class="flex items-center flex-col md:flex-row md:flex-wrap gap-2 mb-4">
    <div class="hidden md:flex md:items-end gap-2 md:w-fit">
      <a href="<%= url_for(params: request.query_parameters.except('status')) %>" class="<%= params[:status].blank? ? 'border-neutral-700' : 'border-neutral-300' %> flex h-10 px-2 py-1 text-lg items-center justify-between border text-center text-neutral font-semibold rounded-xl w-full md:w-48 hover:border-neutral-600">
        <div class="flex items-center space-x-1">
          <%= svg_icon('list', class: 'w-5 h-5') %>
          <span class="font-normal"><%= t('all') %></span>
        </div>
        <% unless can?(:manage, :countless) %>
          <div class="badge badge-neutral badge-outline font-medium">
            <%= @all_count %>
          </div>
        <% end %>
      </a>
      <a href="<%= url_for(params: request.query_parameters.merge('status' => 'pending')) %>" class="<%= params[:status] == 'pending' ? 'border-neutral-700' : 'border-neutral-300' %> flex h-10 px-2 py-1 text-lg items-center justify-between border text-center text-neutral font-semibold rounded-xl w-full md:w-48 hover:border-neutral-600">
        <div class="flex items-center space-x-1">
          <%= svg_icon('clock', class: 'w-5 h-5') %>
          <span class="font-normal"><%= t('pending') %></span>
        </div>
        <% unless can?(:manage, :countless) %>
          <div class="badge badge-neutral badge-outline font-medium">
            <%= @pending_count %>
          </div>
        <% end %>
      </a>
      <a href="<%= url_for(params: request.query_parameters.merge('status' => 'completed')) %>" class="<%= params[:status] == 'completed' ? 'border-neutral-700' : 'border-neutral-300' %> flex h-10 px-2 py-1 text-lg items-center justify-between border text-center text-neutral font-semibold rounded-xl w-full md:w-48 hover:border-neutral-600">
        <div class="flex items-center space-x-1">
          <%= svg_icon('circle_check', class: 'w-5 h-5') %>
          <span class="font-normal"><%= t('completed') %></span>
        </div>
        <% unless can?(:manage, :countless) %>
          <div class="badge badge-neutral badge-outline font-medium">
            <%= @completed_count %>
          </div>
        <% end %>
      </a>
    </div>
    <div class="flex items-center md:items-end gap-2 w-full md:w-fit">
      <%= render 'submissions_filters/completed_at_button', filter_params: %>
      <%= render 'submissions_filters/filter_button', filter_params:, without_completed_at: true %>
      <%= render 'submissions_filters/phone_documents_button', filter_params: %>
      <%= render 'submissions_filters/applied_filters', filter_params:, with_status: true, without_completed_at: true, all_count: @all_count, pending_count: @pending_count, completed_count: @completed_count %>
      <%= render 'submissions_filters/actions', filter_params: %>
    </div>
  </div>
<% end %>
<% if @submissions_by_date.present? %>
  <div class="space-y-6">
    <% @submissions_by_date.each do |date, date_submissions| %>
      <% date_id = date.strftime('%Y%m%d') %>
      <% date_count = @date_counts[date] || date_submissions.size %>
      <div class="date-group-section space-y-3">
        <div class="flex items-center gap-3 pt-2">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-base-200 border border-base-300 text-sm font-bold text-base-content shadow">
            <%= svg_icon('calendar', class: 'w-4 h-4 stroke-2') %>
            <span><%= date.strftime('%d-%m-%Y') %></span>
            <% if date == @today_date %>
              <span class="badge badge-sm badge-neutral font-medium ml-1">Today</span>
            <% elsif date == @yesterday_date %>
              <span class="badge badge-sm badge-ghost font-medium ml-1">Yesterday</span>
            <% end %>
            <span class="badge badge-sm badge-outline ml-1 font-mono font-normal opacity-70"><%= date_count %></span>

            <span class="tooltip tooltip-top tooltip-no-touch" data-tip="<%= t('download', default: 'Download') %> (<%= date_count %>)">
              <button type="button"
                      data-action="open-download-modal"
                      data-target="download_modal_<%= date_id %>"
                      class="btn btn-ghost btn-xs btn-circle ml-0.5 hover:bg-base-300 text-base-content/70 hover:text-base-content transition-colors cursor-pointer"
                      aria-label="<%= t('download', default: 'Download') %> (<%= date_count %>)">
                <%= svg_icon('download', class: 'w-4 h-4 stroke-2 pointer-events-none') %>
              </button>
            </span>
          </div>
          <div class="border-t border-base-300 flex-1"></div>
        </div>
        <div class="space-y-4">
          <%= render partial: 'templates/submission', collection: date_submissions, locals: { with_template: true } %>
        </div>
        <%= render 'submissions_by_date_dashboard/date_download_modal', date:, date_id:, docs_count: date_count, download_params: filter_params.to_h.merge(q: params[:q]).compact_blank %>
      </div>
    <% end %>
  </div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  if (!window.__submissionsDateDownloadHandler) {
    window.__submissionsDateDownloadHandler = true;

    window.openDownloadModal = function(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      if (typeof modal.showModal === 'function') {
        try { modal.showModal(); } catch (e) { /* ignore if already open */ }
      }
      modal.classList.add('modal-open');
    };

    window.closeDownloadModal = function(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      if (typeof modal.close === 'function') {
        try { modal.close(); } catch (e) { /* ignore */ }
      }
      modal.classList.remove('modal-open');
    };

    document.addEventListener('click', function(e) {
      const openBtn = e.target.closest('[data-action="open-download-modal"]');
      if (openBtn) {
        e.preventDefault();
        e.stopPropagation();
        const modalId = openBtn.getAttribute('data-target');
        window.openDownloadModal(modalId);
        return;
      }

      const closeBtn = e.target.closest('[data-action="close-download-modal"]');
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();
        const modalId = closeBtn.getAttribute('data-target');
        window.closeDownloadModal(modalId);
        return;
      }

      const zipBtn = e.target.closest('[data-action="download-zip"]');
      if (zipBtn) {
        const modalId = zipBtn.getAttribute('data-target');
        setTimeout(() => {
          window.closeDownloadModal(modalId);
        }, 600);
        return;
      }

      const oneByOneBtn = e.target.closest('[data-action="download-one-by-one"]');
      if (oneByOneBtn) {
        e.preventDefault();
        e.stopPropagation();
        const dateId = oneByOneBtn.getAttribute('data-date-id');
        const docsUrl = oneByOneBtn.getAttribute('data-docs-url');
        if (window.startDownloadOneByOne) {
          window.startDownloadOneByOne(dateId, docsUrl, oneByOneBtn);
        }
        return;
      }
    });

    window.startDownloadOneByOne = async function(dateId, docsUrl, btn) {
      const actionsEl = document.getElementById('download_actions_' + dateId);
      const progressEl = document.getElementById('download_progress_' + dateId);
      const progressText = document.getElementById('download_progress_text_' + dateId);
      const progressCount = document.getElementById('download_progress_count_' + dateId);
      const progressBar = document.getElementById('download_progress_bar_' + dateId);
      const modalId = 'download_modal_' + dateId;

      try {
        btn.disabled = true;
        if (actionsEl) actionsEl.classList.add('opacity-50', 'pointer-events-none');
        if (progressEl) progressEl.classList.remove('hidden');
        if (progressText) progressText.innerText = 'Fetching document list...';
        if (progressBar) progressBar.value = 10;

        const response = await fetch(docsUrl, { credentials: 'same-origin' });
        if (!response.ok) throw new Error('Failed to retrieve documents for download');

        const files = await response.json();
        if (!files || files.length === 0) {
          alert('No documents found for this date.');
          if (actionsEl) actionsEl.classList.remove('opacity-50', 'pointer-events-none');
          if (progressEl) progressEl.classList.add('hidden');
          btn.disabled = false;
          return;
        }

        const total = files.length;
        for (let i = 0; i < total; i++) {
          const file = files[i];
          const percent = Math.round(((i + 1) / total) * 100);
          if (progressText) progressText.innerText = `Downloading: ${file.filename}`;
          if (progressCount) progressCount.innerText = `${i + 1} / ${total}`;
          if (progressBar) progressBar.value = percent;

          try {
            const fileResp = await fetch(file.url);
            if (!fileResp.ok) throw new Error('File download failed');
            const blob = await fileResp.blob();
            const blobUrl = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = file.filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
          } catch (err) {
            const a = document.createElement('a');
            a.href = file.url;
            a.download = file.filename;
            a.target = '_blank';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }

          if (i < total - 1) {
            await new Promise(resolve => setTimeout(resolve, 400));
          }
        }

        if (progressText) progressText.innerText = 'All downloads started!';
        if (progressBar) progressBar.value = 100;
        setTimeout(() => {
          if (actionsEl) actionsEl.classList.remove('opacity-50', 'pointer-events-none');
          if (progressEl) progressEl.classList.add('hidden');
          btn.disabled = false;
          window.closeDownloadModal(modalId);
        }, 1000);
      } catch (e) {
        console.error('Download error:', e);
        alert('Error downloading files: ' + (e.message || 'Unknown error'));
        if (actionsEl) actionsEl.classList.remove('opacity-50', 'pointer-events-none');
        if (progressEl) progressEl.classList.add('hidden');
        btn.disabled = false;
      }
    };
  }
</script>
<% if params[:q].blank? && params[:status].blank? && filter_params.blank? && @pagy.count.present? && @pagy.count < 5 && @submissions_by_date.blank? %>
  <% if can?(:create, ::Template) %>
    <%= render 'templates/dropzone' %>
  <% elsif @pagy.count.zero? %>
    <div class="text-center">
      <div class="mt-16 text-3xl font-semibold">
        <%= t('there_are_no_submissions') %>
      </div>
    </div>
  <% end %>
<% end %>
<% if @submissions.present? || (params[:q].blank? && filter_params.blank?) %>
  <% if @pagy.pages > 1 %>
    <%= render 'shared/pagination', pagy: @pagy, items_name: 'submissions', left_additional_html: view_archived_html %>
  <% else %>
    <div class="mt-2">
      <%= view_archived_html %>
    </div>
  <% end %>
<% elsif params[:q].present? || filter_params.present? %>
  <div class="text-center">
    <div class="mt-16 text-3xl font-semibold">
      <%= t('submissions_not_found') %>
    </div>
  </div>
<% end %>
