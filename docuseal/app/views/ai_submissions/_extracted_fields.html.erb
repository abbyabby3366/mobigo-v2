<%
  template_fields = template.fields.to_a
  translations = {
    'Nombor Pesanan' => 'Order Number',
    'Nama Penerima ("Pihak B")' => 'Recipient Name',
    'Nombor Telefon ("Pihak B")' => 'Recipient Phone',
    'Alamat Penghantaran ("Pihak B")' => 'Delivery Address',
    'E-mel ("Pihak B")' => 'Recipient Email',
    'Nama Produk' => 'Product Name / Model',
    'Nombor IMEI Telefon' => 'IMEI Number',
    'Siri Telefon' => 'Serial Number',
    'Nombor IMEI Telefon/ Siri Telefon' => 'IMEI / Serial Number',
    'Kuantiti Peralatan' => 'Equipment Quantity',
    'Tarikh mula sewaan' => 'Rental Start Date',
    'Tarikh akhir sewaan' => 'Rental End Date',
    'Jumlah Tempoh Sewaan' => 'Total Rental Period',
    'Harga Sewa Sebulan' => 'Monthly Rental Price',
    'Jumlah Sewa' => 'Total Rental Amount',
    'Deposit Produk' => 'Product Deposit',
    'Harga Pasaran/Harga Produk' => 'Retail / Market Price',
    'Tandatangan Penerima ("Pihak B")' => 'Recipient Signature',
    'Nama' => 'Name',
    'No. Kad Pengenalan' => 'IC / MyKad Number',
    'Tarikh Penerimaan' => 'Receipt Date'
  }
%>


<div class="space-y-6">
  <!-- AI Extraction Overview Banner -->
  <div class="alert bg-base-100 border border-base-300 rounded-2xl p-4 shadow-sm flex items-start justify-between">
    <div class="flex items-start space-x-3">
      <div class="p-2 bg-neutral-900 text-yellow-400 rounded-xl shadow-xs flex-shrink-0">
        <%= svg_icon('sparkles', class: 'w-5 h-5 stroke-2') %>
      </div>
      <div>
        <div class="text-sm font-bold text-base-content">Data Extracted Successfully by Gemini 3.6 Flash</div>
        <p class="text-xs text-base-content/70 mt-0.5"><%= summary.presence || 'All fields and recipient details have been automatically populated from your documents and text notes.' %></p>
      </div>
    </div>
    <span class="badge badge-neutral font-mono text-xs py-2.5 px-3 flex-shrink-0">AI Verified</span>
  </div>

  <!-- Tab selector: Form View vs JSON Output View -->
  <div class="flex border-b border-base-300">
    <button type="button" id="tab_btn_form" data-action="switch-tab-form" class="py-2.5 px-4 text-xs font-bold border-b-2 border-neutral-900 text-neutral-900 transition-colors cursor-pointer">
      Form Fields (Review & Edit)
    </button>
    <button type="button" id="tab_btn_json" data-action="switch-tab-json" class="py-2.5 px-4 text-xs font-semibold border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-colors flex items-center space-x-1 cursor-pointer">
      <span>JSON Output</span>
      <span class="badge badge-xs badge-neutral font-mono">JSON</span>
    </button>
  </div>


  <!-- Form Fields Tab -->
  <div id="ai_tab_form" class="space-y-6">
    <%= form_with url: ai_submissions_path, method: :post, id: 'ai_create_submission_form', local: true, class: 'space-y-6' do |f| %>
      <%= hidden_field_tag :template_id, template.id %>

      <% submitters.each_with_index do |sub, idx| %>
        <% sub_fields = template_fields.select { |tf| tf['submitter_uuid'] == sub['uuid'] } %>

        <!-- SECTION 1: Recipient Information (Extracted Email & Contact) -->
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-base-200">
            <div class="flex items-center space-x-2">
              <div class="p-1.5 bg-neutral-900 text-white rounded-lg">
                <%= svg_icon('mail', class: 'w-4 h-4') %>
              </div>
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/90">
                  1. Recipient Information & Delivery Email
                </h3>
                <p class="text-[11px] text-base-content/60">Auto-extracted from your notes & documents (where document signature link will be sent)</p>
              </div>
            </div>
            <span class="badge badge-neutral text-xs font-semibold"><%= sub['role'] || "Party #{idx + 1}" %></span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Recipient Email -->
            <div class="md:col-span-1">
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-bold text-base-content/90">
                  Recipient Email (Auto-extracted)
                </label>
                <span class="badge badge-xs badge-neutral font-mono text-[9px]">Destination</span>
              </div>
              <%= email_field_tag "submission[submitters][#{idx}][email]", sub['email'], class: 'input input-sm input-bordered font-medium w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100', placeholder: 'Enter or confirm email address', required: true %>
            </div>

            <!-- Recipient Name -->
            <div class="md:col-span-1">
              <label class="block text-xs font-bold text-base-content/90 mb-1">
                Recipient Name (Auto-extracted)
              </label>
              <%= text_field_tag "submission[submitters][#{idx}][name]", sub['name'], class: 'input input-sm input-bordered font-medium w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100', placeholder: 'Enter or confirm recipient name' %>
            </div>

            <!-- Recipient Phone -->
            <div class="md:col-span-1">
              <label class="block text-xs font-bold text-base-content/90 mb-1">
                Phone Number (Auto-extracted)
              </label>
              <%= telephone_field_tag "submission[submitters][#{idx}][phone]", sub['phone'], class: 'input input-sm input-bordered font-medium w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100', placeholder: 'Enter or confirm phone number' %>
            </div>
          </div>


          <%= hidden_field_tag "submission[submitters][#{idx}][uuid]", sub['uuid'] %>
        </div>

        <!-- SECTION 2: Agreement Document Field Values -->
        <% if sub_fields.present? %>
          <% sub_sig_count = sub_fields.count { |f| f['type'] == 'signature' } %>
          <% sub_data_count = sub_fields.size - sub_sig_count %>
          <div class="card bg-base-100 border border-base-300 rounded-2xl p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-base-200">
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/90">
                  2. Document Agreement Field Values (<%= sub_data_count %> data fields<%= ", #{sub_sig_count} signature" if sub_sig_count.positive? %>)
                </h3>
                <p class="text-[11px] text-base-content/60">Populated automatically from MyKad IC, calculator screenshot, device box labels & notes</p>
              </div>
              <span class="badge badge-sm badge-ghost font-mono text-xs"><%= sub_data_count %> data + <%= sub_sig_count %> sign</span>
            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% sub_fields.each do |tf| %>
                <% val = (sub['values'] || {})[tf['name']] || fields[tf['name']] || '' %>
                <% en_trans = translations[tf['name']] %>
                <div class="<%= 'md:col-span-2' if ['Alamat Penghantaran ("Pihak B")', 'Tandatangan Penerima ("Pihak B")'].include?(tf['name']) %> bg-base-200/50 p-3 rounded-xl border border-base-200">
                  <div class="flex items-center justify-between mb-1.5">
                    <label class="text-xs font-semibold text-base-content truncate flex items-center space-x-1.5">
                      <span><%= tf['name'] %></span>
                      <% if en_trans.present? %>
                        <span class="text-[11px] text-base-content/50 font-normal italic">(<%= en_trans %>)</span>
                      <% end %>
                      <% if tf['required'] %><span class="text-error font-bold">*</span><% end %>
                    </label>
                    <span class="badge badge-xs badge-ghost text-[10px] uppercase font-mono"><%= tf['type'] %></span>
                  </div>

                  <% if tf['type'] == 'checkbox' %>
                    <label class="cursor-pointer label justify-start gap-2 py-1">
                      <%= check_box_tag "submission[submitters][#{idx}][values][#{tf['name']}]", 'true', [true, 'true', '1', 1, 'yes'].include?(val), class: 'checkbox checkbox-sm checkbox-neutral rounded-lg' %>
                      <span class="label-text text-xs text-base-content/80 font-medium">Checked / Agreed</span>
                    </label>
                  <% elsif tf['type'] == 'date' %>
                    <%= date_field_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, class: 'input input-sm input-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium' %>
                  <% elsif tf['type'] == 'textarea' || tf['name'].include?('Alamat') %>
                    <%= text_area_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, rows: 2, class: 'textarea textarea-sm textarea-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium' %>
                  <% elsif tf['type'] == 'signature' %>
                    <div class="p-3 bg-base-100 rounded-xl border border-dashed border-base-300 text-xs text-base-content/60 flex items-center space-x-2">
                      <%= svg_icon('writing_sign', class: 'w-4 h-4 text-neutral-600') %>
                      <span>Signature field assigned to recipient for online signing upon delivery.</span>
                    </div>

                  <% else %>
                    <%= text_field_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, class: 'input input-sm input-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium', placeholder: "Value for #{tf['name']}" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      <% end %>

      <!-- Bottom Action Bar -->
      <div class="pt-3 flex items-center justify-between">
        <button type="button" id="reupload_btn" data-action="reupload" class="btn btn-ghost btn-sm text-xs gap-1.5 rounded-xl font-medium cursor-pointer">
          <%= svg_icon('arrow_left', class: 'w-4 h-4') %>
          <span>Re-upload / Modify Data</span>
        </button>

        <%= f.submit 'Create Document Submission', class: 'btn btn-neutral !bg-neutral-900 hover:!bg-black !text-white text-xs px-8 !h-11 !rounded-xl shadow-sm hover:shadow-md font-bold cursor-pointer' %>
      </div>

    <% end %>
  </div>

  <!-- JSON Output Tab -->
  <div id="ai_tab_json" class="hidden space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-xs text-base-content/70 font-semibold">Raw Extracted JSON Output</span>
      <button type="button" id="copy_json_btn" data-action="copy-json" class="btn btn-sm !bg-neutral-800 hover:!bg-black !text-white !border-neutral-800 text-xs !rounded-xl gap-1.5 font-medium shadow-sm cursor-pointer">
        <%= svg_icon('clipboard_copy', class: 'w-3.5 h-3.5 stroke-2 text-white') %>
        <span id="copy_json_label" class="text-white font-medium">Copy JSON</span>
      </button>
    </div>
    <pre id="extracted_json_pre" class="p-4 bg-neutral text-neutral-content text-xs font-mono rounded-2xl overflow-x-auto max-h-[500px] leading-relaxed select-all shadow-inner"><%= JSON.pretty_generate(raw_json.presence || extracted_data.slice(:summary, :submitters, :fields)) %></pre>
  </div>

</div>
