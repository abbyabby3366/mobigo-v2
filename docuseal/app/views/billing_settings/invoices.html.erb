<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0 md:space-x-8 px-3 sm:px-6">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-3xl">
    <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-center mb-6">
      <div>
        <div class="flex items-center space-x-2 text-xs opacity-70 mb-1">
          <%= link_to settings_billing_index_path, class: 'hover:underline flex items-center gap-1 font-medium' do %>
            <%= svg_icon('arrow_left', class: 'w-3 h-3') rescue '←' %>
            <span>Back to Billing</span>
          <% end %>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold">
          Invoices & Top-Up History
        </h1>
        <p class="text-sm opacity-70 mt-1">
          Complete record of all balance top-ups and receipts for your account.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0 self-start md:self-auto">
        <%= link_to invoices_settings_billing_index_path(params.permit(:start_date, :end_date).merge(format: :csv)), class: 'btn btn-primary btn-sm gap-2' do %>
          <%= svg_icon('download', class: 'w-4 h-4') rescue '' %>
          <span>Download CSV</span>
        <% end %>
      </div>
    </div>



    <!-- Date Range Filter Form -->
    <div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
      <div class="card-body p-4">
        <%= form_with url: invoices_settings_billing_index_path, method: :get, local: true, class: 'flex flex-wrap items-end gap-3' do %>
          <div class="flex-1 min-w-[140px]">
            <label class="block text-xs uppercase tracking-wider font-semibold opacity-60 mb-1">
              Start Date
            </label>
            <input type="date" name="start_date" value="<%= params[:start_date] %>" class="input input-bordered input-sm w-full" />
          </div>

          <div class="flex-1 min-w-[140px]">
            <label class="block text-xs uppercase tracking-wider font-semibold opacity-60 mb-1">
              End Date
            </label>
            <input type="date" name="end_date" value="<%= params[:end_date] %>" class="input input-bordered input-sm w-full" />
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button type="submit" class="btn btn-sm btn-neutral gap-1">
              <%= svg_icon('search', class: 'w-3.5 h-3.5') rescue '' %>
              <span>Filter</span>
            </button>

            <% if params[:start_date].present? || params[:end_date].present? %>
              <%= link_to 'Clear', invoices_settings_billing_index_path, class: 'btn btn-sm btn-ghost' %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Invoices Table Card -->
    <div class="card bg-base-200 border border-base-300 shadow-sm mb-6">
      <div class="card-body p-6">
        <% if @invoices.present? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-sm">
              <thead>
                <tr class="text-xs uppercase opacity-60">
                  <th>Invoice ID</th>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Method</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th class="text-right">Action</th>
                </tr>
              </thead>
              <tbody>
                <% @invoices.each do |inv| %>
                  <tr>
                    <td class="font-mono text-xs font-semibold text-primary whitespace-nowrap">
                      <%= link_to inv['id'], invoice_settings_billing_index_path(id: inv['id']), target: '_blank', class: 'link link-hover' %>
                    </td>
                    <td class="font-mono text-xs opacity-70 whitespace-nowrap">
                      <%= Time.zone.parse(inv['date'].to_s)&.in_time_zone(current_account&.timezone || 'Singapore')&.strftime('%b %d, %Y %H:%M') rescue inv['date'] %>
                    </td>
                    <td>
                      <div class="font-medium text-base-content">
                        <%= inv['description'] || 'Balance Top-Up' %>
                      </div>
                    </td>
                    <td>
                      <span class="badge badge-sm badge-ghost font-medium"><%= inv['payment_method'] || 'API' %></span>
                    </td>
                    <td class="font-mono font-medium text-success whitespace-nowrap">
                      +$<%= sprintf('%.2f', inv['amount'].to_f) %> USD
                    </td>
                    <td>
                      <span class="badge badge-sm badge-success gap-1">
                        <%= svg_icon('check', class: 'w-3 h-3') rescue '' %> <%= inv['status'] || 'Paid' %>
                      </span>
                    </td>
                    <td class="text-right whitespace-nowrap">
                      <%= link_to invoice_settings_billing_index_path(id: inv['id']), target: '_blank', class: 'btn btn-ghost btn-xs text-primary gap-1' do %>
                        <%= svg_icon('file_text', class: 'w-3.5 h-3.5') rescue '' %>
                        <span>Invoice</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8 bg-base-100 rounded-lg border border-dashed border-base-300">
            <%= svg_icon('file_text', class: 'w-10 h-10 opacity-30 mx-auto mb-2') rescue '' %>
            <p class="font-medium opacity-80">
              <% if params[:start_date].present? || params[:end_date].present? %>
                No invoices found for the selected date range
              <% else %>
                No invoices recorded yet. Top up your balance to generate your first invoice.
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
