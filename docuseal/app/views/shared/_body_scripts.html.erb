<script nonce="<%= content_security_policy_nonce %>">
  if (!window.customElements.get('date-download-trigger')) {
    window.customElements.define('date-download-trigger', class extends HTMLElement {
      connectedCallback() {
        const openModal = (e) => {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          const targetId = this.getAttribute('data-target') || this.dataset.target;
          const modal = document.getElementById(targetId);
          if (!modal) return;
          if (modal.open) return;
          if (typeof modal.showModal === 'function') {
            try { modal.showModal(); } catch (err) { modal.classList.add('modal-open'); }
          } else {
            modal.classList.add('modal-open');
          }
        };

        this.addEventListener('click', openModal);
        let touchMoved = false;
        this.addEventListener('touchstart', () => { touchMoved = false; }, { passive: true });
        this.addEventListener('touchmove', () => { touchMoved = true; }, { passive: true });
        this.addEventListener('touchend', (e) => {
          if (!touchMoved) {
            openModal(e);
          }
        });
      }
    });
  }

  if (!window.__submissionsDateDownloadHandler) {
    window.__submissionsDateDownloadHandler = true;

    window.openDownloadModal = function(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      if (typeof modal.showModal === 'function') {
        try { modal.showModal(); } catch (e) { modal.classList.add('modal-open'); }
      } else {
        modal.classList.add('modal-open');
      }
    };

    window.closeDownloadModal = function(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      if (typeof modal.close === 'function') {
        try { modal.close(); } catch (e) { /* ignore */ }
      }
      modal.classList.remove('modal-open');
    };

    document.addEventListener('click', function(e) {
      const openBtn = e.target.closest('[data-action="open-download-modal"]');
      if (openBtn) {
        e.preventDefault();
        e.stopPropagation();
        const modalId = openBtn.getAttribute('data-target') || openBtn.dataset.target;
        window.openDownloadModal(modalId);
        return;
      }

      const closeBtn = e.target.closest('[data-action="close-download-modal"]');
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();
        const modalId = closeBtn.getAttribute('data-target') || closeBtn.dataset.target;
        window.closeDownloadModal(modalId);
        return;
      }

      const zipBtn = e.target.closest('[data-action="download-zip"]');
      if (zipBtn) {
        const modalId = zipBtn.getAttribute('data-target') || zipBtn.dataset.target;
        setTimeout(() => {
          window.closeDownloadModal(modalId);
        }, 600);
        return;
      }

      const oneByOneBtn = e.target.closest('[data-action="download-one-by-one"]');
      if (oneByOneBtn) {
        e.preventDefault();
        e.stopPropagation();
        const dateId = oneByOneBtn.getAttribute('data-date-id') || oneByOneBtn.dataset.dateId;
        const docsUrl = oneByOneBtn.getAttribute('data-docs-url') || oneByOneBtn.dataset.docsUrl;
        if (window.startDownloadOneByOne) {
          window.startDownloadOneByOne(dateId, docsUrl, oneByOneBtn);
        }
        return;
      }
    });

    window.startDownloadOneByOne = async function(dateId, docsUrl, btn) {
      const actionsEl = document.getElementById('download_actions_' + dateId);
      const progressEl = document.getElementById('download_progress_' + dateId);
      const progressText = document.getElementById('download_progress_text_' + dateId);
      const progressCount = document.getElementById('download_progress_count_' + dateId);
      const progressBar = document.getElementById('download_progress_bar_' + dateId);
      const modalId = 'download_modal_' + dateId;

      try {
        btn.disabled = true;
        if (actionsEl) actionsEl.classList.add('opacity-50', 'pointer-events-none');
        if (progressEl) progressEl.classList.remove('hidden');
        if (progressText) progressText.innerText = 'Fetching document list...';
        if (progressBar) progressBar.value = 10;

        const response = await fetch(docsUrl, { credentials: 'same-origin' });
        if (!response.ok) throw new Error('Failed to retrieve documents for download');

        const files = await response.json();
        if (!files || files.length === 0) {
          alert('No documents found for this date.');
          if (actionsEl) actionsEl.classList.remove('opacity-50', 'pointer-events-none');
          if (progressEl) progressEl.classList.add('hidden');
          btn.disabled = false;
          return;
        }

        const total = files.length;
        const isMobileSafariIos = 'ontouchstart' in window && navigator.maxTouchPoints > 0 && /AppleWebKit/i.test(navigator.userAgent);
        const isSafariIos = isMobileSafariIos || /iPhone|iPad|iPod/i.test(navigator.userAgent);

        for (let i = 0; i < total; i++) {
          const file = files[i];
          const percent = Math.round(((i + 1) / total) * 100);
          if (progressText) progressText.innerText = 'Downloading: ' + file.filename;
          if (progressCount) progressCount.innerText = (i + 1) + ' / ' + total;
          if (progressBar) progressBar.value = percent;

          try {
            const fileResp = await fetch(file.url);
            if (!fileResp.ok) throw new Error('File download failed');
            const blob = await fileResp.blob();
            const finalBlob = isSafariIos ? blob.slice(0, blob.size, 'application/octet-stream') : blob;
            const blobUrl = URL.createObjectURL(finalBlob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = file.filename;
            if (isSafariIos) a.target = '_blank';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
          } catch (err) {
            const a = document.createElement('a');
            a.href = file.url;
            a.download = file.filename;
            a.target = '_blank';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }

          if (i < total - 1) {
            await new Promise(resolve => setTimeout(resolve, 500));
          }
        }

        if (progressText) progressText.innerText = 'All downloads started!';
        if (progressBar) progressBar.value = 100;
        setTimeout(() => {
          if (actionsEl) actionsEl.classList.remove('opacity-50', 'pointer-events-none');
          if (progressEl) progressEl.classList.add('hidden');
          btn.disabled = false;
          window.closeDownloadModal(modalId);
        }, 1200);
      } catch (e) {
        console.error('Download error:', e);
        alert('Error downloading files: ' + (e.message || 'Unknown error'));
        if (actionsEl) actionsEl.classList.remove('opacity-50', 'pointer-events-none');
        if (progressEl) progressEl.classList.add('hidden');
        btn.disabled = false;
      }
    };
  }
</script>
