<%
  template_fields = template.fields.to_a
%>


<div class="space-y-6">
  <!-- Tab selector: Form View vs JSON Output View -->
  <div class="flex border-b border-base-300">
    <button type="button" id="tab_btn_form" data-action="switch-tab-form" class="py-2.5 px-4 text-xs font-bold border-b-2 border-neutral-900 text-neutral-900 transition-colors cursor-pointer">
      Form Fields (Review & Edit)
    </button>
    <button type="button" id="tab_btn_json" data-action="switch-tab-json" class="py-2.5 px-4 text-xs font-semibold border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-colors cursor-pointer">
      JSON Output
    </button>
  </div>


  <!-- Form Fields Tab -->
  <div id="ai_tab_form" class="space-y-6">
    <%= form_with url: ai_submissions_path, method: :post, id: 'ai_create_submission_form', local: true, class: 'space-y-6' do |f| %>
      <%= hidden_field_tag :template_id, template.id %>

      <% submitters.each_with_index do |sub, idx| %>
        <% sub_fields = template_fields.select { |tf| tf['submitter_uuid'] == sub['uuid'] } %>

        <!-- SECTION 1: Recipient Information (Extracted Email & Contact) -->
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-base-200">
            <div class="flex items-center space-x-2">
              <div class="p-1.5 bg-neutral-900 text-white rounded-lg">
                <%= svg_icon('mail', class: 'w-4 h-4') %>
              </div>
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/90">
                  1. Recipient Information & Delivery Email
                </h3>
                <p class="text-[11px] text-base-content/60">Auto-extracted from your notes & documents (where document signature link will be sent)</p>
              </div>
            </div>
            <span class="badge badge-neutral text-xs font-semibold"><%= sub['role'] || "Party #{idx + 1}" %></span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Recipient Email -->
            <div class="md:col-span-1">
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-bold text-base-content/90">
                  Recipient Email (Auto-extracted) <span class="text-error font-bold">*</span>
                </label>
                <span class="badge badge-xs badge-neutral font-mono text-[9px]">Destination</span>
              </div>
              <%= email_field_tag "submission[submitters][#{idx}][email]", sub['email'], class: 'input input-sm input-bordered font-medium w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100', placeholder: 'Enter or confirm email address', required: true %>
            </div>

            <!-- Recipient Name -->
            <div class="md:col-span-1">
              <label class="block text-xs font-bold text-base-content/90 mb-1">
                Recipient Name (Auto-extracted)
              </label>
              <%= text_field_tag "submission[submitters][#{idx}][name]", sub['name'], class: 'input input-sm input-bordered font-medium w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100', placeholder: 'Enter or confirm recipient name' %>
            </div>

            <!-- Recipient Phone -->
            <div class="md:col-span-1">
              <label class="block text-xs font-bold text-base-content/90 mb-1">
                Phone Number (Auto-extracted)
              </label>
              <%= telephone_field_tag "submission[submitters][#{idx}][phone]", sub['phone'], class: 'input input-sm input-bordered font-medium w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100', placeholder: 'Enter or confirm phone number' %>
            </div>
          </div>


          <%= hidden_field_tag "submission[submitters][#{idx}][uuid]", sub['uuid'] %>
        </div>

        <!-- SECTION 2: Agreement Document Field Values -->
        <% if sub_fields.present? %>
          <% sub_raw_fields = sub_fields.select { |tf| tf['type'] != 'signature' && !AiSubmissionExtractor.processed_data_field?(tf['name'], tf['type']) } %>
          <% sub_processed_fields = sub_fields.select { |tf| tf['type'] != 'signature' && AiSubmissionExtractor.processed_data_field?(tf['name'], tf['type']) } %>
          <% sub_signatures = sub_fields.select { |tf| tf['type'] == 'signature' } %>
          <div class="card bg-base-100 border border-base-300 rounded-2xl p-5 shadow-sm space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-base-200">
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-base-content/90">
                  2. Document Agreement Field Values (<%= sub_raw_fields.size + sub_processed_fields.size %> data fields<%= ", #{sub_signatures.size} signature" if sub_signatures.present? %>)
                </h3>
                <p class="text-[11px] text-base-content/60">Populated automatically from MyKad IC, calculator screenshot, device box labels & notes</p>
              </div>
              <div class="flex items-center space-x-1.5">
                <span class="badge badge-sm font-mono text-xs" style="background-color: #18181b !important; color: #ffffff !important;"><%= sub_raw_fields.size %> Raw</span>
                <span class="badge badge-sm font-mono text-xs" style="background-color: #3f3f46 !important; color: #ffffff !important;"><%= sub_processed_fields.size %> Processed</span>
                <% if sub_signatures.present? %>
                  <span class="badge badge-sm font-mono text-xs" style="background-color: #ffffff !important; color: #18181b !important; border: 1px solid #71717a !important;"><%= sub_signatures.size %> Sign</span>
                <% end %>
              </div>
            </div>

            <!-- 2A. Raw Data Fields -->
            <% if sub_raw_fields.present? %>
              <div class="space-y-3">
                <div class="flex items-center justify-between pb-1">
                  <div class="flex items-center space-x-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-base-content/90">Raw Data Fields (<%= sub_raw_fields.size %>)</span>
                    <span class="badge badge-xs font-mono text-[9px]" style="background-color: #18181b !important; color: #ffffff !important;">Source Data</span>
                  </div>
                  <span class="text-[10px] text-base-content/70 font-medium">Directly from IC, Box IMEI, Calculator & Notes</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <% sub_raw_fields.each do |tf| %>
                    <% val = (sub['values'] || {})[tf['name']] || fields[tf['name']] || '' %>
                    <% field_name = tf['name'].presence || 'Field' %>
                    <% en_trans = AiSubmissionExtractor.translation_for(tf['name'], tf['type']) %>
                    <div class="<%= 'md:col-span-2' if ['Alamat Penghantaran ("Pihak B")', 'Alamat Penghantaran'].include?(tf['name']) %> bg-base-200/50 p-3 rounded-xl border border-base-200">
                      <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-semibold text-base-content truncate flex items-center space-x-1.5">
                          <span><%= field_name %></span>
                          <% if en_trans.present? %>
                            <span class="text-[11px] text-neutral-700 font-medium italic">(<%= en_trans %>)</span>
                          <% end %>
                          <% if [true, 'true', 1, '1'].include?(tf['required']) %><span class="text-error font-bold">*</span><% end %>
                        </label>
                        <span class="badge badge-xs text-[10px] uppercase font-mono" style="background-color: #f4f4f5 !important; color: #18181b !important; border: 1px solid #e4e4e7 !important;"><%= tf['type'] %></span>
                      </div>

                      <% if tf['type'] == 'checkbox' %>
                        <label class="cursor-pointer label justify-start gap-2 py-1">
                          <%= check_box_tag "submission[submitters][#{idx}][values][#{tf['name']}]", 'true', [true, 'true', '1', 1, 'yes'].include?(val), class: 'checkbox checkbox-sm checkbox-neutral rounded-lg', data: { field_name: tf['name'] } %>
                          <span class="label-text text-xs text-base-content/80 font-medium">Checked / Agreed</span>
                        </label>
                      <% elsif tf['type'] == 'date' %>
                        <%= date_field_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, class: 'input input-sm input-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium', data: { field_name: tf['name'] } %>
                      <% elsif tf['type'] == 'textarea' || tf['name'].to_s.include?('Alamat') %>
                        <%= text_area_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, rows: 2, class: 'textarea textarea-sm textarea-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium', data: { field_name: tf['name'] } %>
                      <% else %>
                        <%= text_field_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, class: 'input input-sm input-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium', placeholder: "Value for #{field_name}", data: { field_name: tf['name'] }, oninput: "if(['Harga Sewa Sebulan'].includes('#{tf['name']}')) { window.recalculateJumlahSewa && window.recalculateJumlahSewa(); }" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- 2B. Processed Data Fields -->
            <% if sub_processed_fields.present? %>
              <div class="space-y-3 pt-3 border-t border-base-200">
                <div class="flex items-center justify-between pb-1">
                  <div class="flex items-center space-x-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-base-content/90">Processed Data Fields (<%= sub_processed_fields.size %>)</span>
                    <span class="badge badge-xs font-mono text-[9px]" style="background-color: #3f3f46 !important; color: #ffffff !important;">Dates & Orders</span>
                  </div>
                  <span class="text-[10px] text-base-content/70 font-medium">All Date-related fields, Order Number & Calculated Rent</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <% sub_processed_fields.each do |tf| %>
                    <% val = (sub['values'] || {})[tf['name']] || fields[tf['name']] %>
                    <% val = AiSubmissionExtractor.processed_data_value(tf['name'], tf['type'], fields_hash: fields) if val.blank? %>
                    <% field_name = tf['name'].presence || 'Processed Field' %>
                    <% en_trans = AiSubmissionExtractor.translation_for(tf['name'], tf['type']) %>
                    <div class="bg-base-200/50 p-3 rounded-xl border border-base-200">
                      <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-semibold text-base-content truncate flex items-center space-x-1.5">
                          <span><%= field_name %></span>
                          <% if en_trans.present? %>
                            <span class="text-[11px] text-neutral-700 font-medium italic">(<%= en_trans %>)</span>
                          <% end %>
                          <% if tf['name'].to_s.include?('Jumlah Tempoh Sewaan') || tf['name'].to_s.include?('Tempoh Sewaan') %>
                            <span class="badge badge-xs font-mono text-[9px] bg-neutral-200 text-neutral-800 border-neutral-300">Period − 1</span>
                          <% elsif tf['name'].to_s.include?('Jumlah Sewa') %>
                            <span class="badge badge-xs font-mono text-[9px] bg-neutral-200 text-neutral-800 border-neutral-300">Rent × Duration</span>
                          <% end %>
                          <% if [true, 'true', 1, '1'].include?(tf['required']) %><span class="text-error font-bold">*</span><% end %>
                        </label>
                        <span class="badge badge-xs text-[10px] uppercase font-mono" style="background-color: #f4f4f5 !important; color: #18181b !important; border: 1px solid #e4e4e7 !important;"><%= tf['type'] %></span>
                      </div>

                      <% if tf['type'] == 'date' %>
                        <%= date_field_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, class: 'input input-sm input-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium', data: { field_name: tf['name'] } %>
                      <% else %>
                        <%= text_field_tag "submission[submitters][#{idx}][values][#{tf['name']}]", val, class: 'input input-sm input-bordered w-full text-xs rounded-xl focus:border-neutral-900 bg-base-100 font-medium', placeholder: "Value for #{field_name}", data: { field_name: tf['name'] }, oninput: "if(['Jumlah Tempoh Sewaan', 'Tempoh Sewaan'].includes('#{tf['name']}')) { window.recalculateJumlahSewa && window.recalculateJumlahSewa(); }" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- 2C. Signature Fields -->
            <% if sub_signatures.present? %>
              <div class="space-y-3 pt-3 border-t border-base-200">
                <div class="flex items-center justify-between pb-1">
                  <div class="flex items-center space-x-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-base-content/90">Signature Fields (<%= sub_signatures.size %>)</span>
                    <span class="badge badge-xs text-[9px] uppercase font-mono" style="background-color: #ffffff !important; color: #18181b !important; border: 1px solid #71717a !important;">Sign-off</span>
                  </div>
                  <span class="text-[10px] text-base-content/70 font-medium">Online signing upon delivery</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <% sub_signatures.each do |tf| %>
                    <% field_name = tf['name'].presence || 'Recipient Signature' %>
                    <% en_trans = AiSubmissionExtractor.translation_for(tf['name'], 'signature') %>
                    <div class="md:col-span-2 bg-base-200/50 p-3 rounded-xl border border-dashed border-base-300">
                      <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-semibold text-base-content truncate flex items-center space-x-1.5">
                          <span><%= field_name %></span>
                          <% if en_trans.present? %>
                            <span class="text-[11px] text-neutral-700 font-medium italic">(<%= en_trans %>)</span>
                          <% end %>
                          <% if [true, 'true', 1, '1'].include?(tf['required']) %><span class="text-error font-bold">*</span><% end %>
                        </label>
                        <span class="badge badge-xs text-[10px] uppercase font-mono" style="background-color: #18181b !important; color: #ffffff !important;">SIGNATURE</span>
                      </div>

                      <div class="p-3 bg-base-100 rounded-xl border border-dashed border-base-300 text-xs text-base-content/60 flex items-center space-x-2">
                        <%= svg_icon('writing_sign', class: 'w-4 h-4 text-neutral-600') %>
                        <span>Signature field assigned to recipient for online signing upon delivery.</span>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

      <% end %>

      <!-- Bottom Action Bar -->
      <div class="pt-3 flex items-center justify-between">
        <button type="button" id="reupload_btn" data-action="reupload" class="btn btn-ghost btn-sm text-xs gap-1.5 rounded-xl font-medium cursor-pointer">
          <%= svg_icon('arrow_left', class: 'w-4 h-4') %>
          <span>Re-upload / Modify Data</span>
        </button>

        <%= f.submit 'Create Document Submission', class: 'btn btn-neutral !bg-neutral-900 hover:!bg-black !text-white text-xs px-8 !h-11 !rounded-xl shadow-sm hover:shadow-md font-bold cursor-pointer' %>
      </div>

    <% end %>
  </div>

  <!-- JSON Output Tab -->
  <div id="ai_tab_json" class="hidden space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-xs text-base-content/80 font-bold">Raw Extracted JSON Output</span>
      <button type="button" id="copy_json_btn" data-action="copy-json" class="btn btn-sm text-xs !rounded-xl gap-1.5 font-bold shadow-sm cursor-pointer" style="background-color: #18181b !important; color: #ffffff !important; border: 1px solid #18181b !important;">
        <%= svg_icon('clipboard_copy', class: 'w-3.5 h-3.5 stroke-2 text-white') %>
        <span id="copy_json_label" class="font-bold text-white" style="color: #ffffff !important;">Copy JSON</span>
      </button>
    </div>
    <pre id="extracted_json_pre" class="p-4 bg-neutral text-neutral-content text-xs font-mono rounded-2xl overflow-x-auto max-h-[500px] leading-relaxed select-all shadow-inner"><%= JSON.pretty_generate(local_assigns[:raw_json].presence || (local_assigns[:extracted_data] || {}).slice(:summary, :submitters, :fields)) %></pre>
  </div>

</div>
