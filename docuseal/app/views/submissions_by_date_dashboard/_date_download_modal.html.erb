<%# Prompt Modal for downloading documents of a specific date %>
<% date_str = date.strftime('%d-%m-%Y') %>
<% docs_count = date_submissions.size %>
<% zip_url = download_zip_submissions_by_date_index_path(date: date_str, submission_ids:) %>
<% docs_url = documents_submissions_by_date_index_path(submission_ids:) %>

<dialog id="download_modal_<%= date_id %>" class="modal items-start overflow-y-auto" style="z-index: 1000;">
  <div class="modal-box pt-5 pb-6 px-6 mt-20 bg-base-100 shadow-lg rounded-2xl border border-base-300 relative mx-auto" style="max-width: 28rem; width: 92%;">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-base-200 flex items-center justify-center text-base-content shrink-0">
          <%= svg_icon('download', class: 'w-5 h-5 stroke-2') %>
        </div>
        <div>
          <h3 class="font-bold text-lg text-base-content">Download Documents</h3>
          <p class="text-xs text-base-content/70 mt-0.5">
            <%= date_str %> &bull; <%= docs_count %> <%= 'document'.pluralize(docs_count) %>
          </p>
        </div>
      </div>
      <button type="button"
              data-action="close-download-modal"
              data-target="download_modal_<%= date_id %>"
              class="btn btn-sm btn-circle btn-ghost text-base-content/60 hover:text-base-content"
              aria-label="Close">&times;</button>
    </div>

    <p class="text-sm text-base-content/80 mb-4">
      Choose how you want to download all <%= docs_count %> <%= 'document'.pluralize(docs_count) %> for <strong><%= date_str %></strong>:
    </p>

    <div class="space-y-3" id="download_actions_<%= date_id %>">
      <!-- Option 1: Download as Zip file -->
      <a href="<%= zip_url %>"
         download="submissions_<%= date_str %>.zip"
         data-action="download-zip"
         data-target="download_modal_<%= date_id %>"
         class="flex items-center justify-between p-3 rounded-xl border border-base-300 hover:border-neutral-700 hover:bg-base-200 transition-all group cursor-pointer text-base-content">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-lg bg-base-300 text-base-content flex items-center justify-center shrink-0 shadow">
            <%= svg_icon('archive', class: 'w-5 h-5 stroke-2') %>
          </div>
          <div class="flex flex-col text-left">
            <span class="font-semibold text-sm group-hover:text-base-content transition-colors">Download as Zip file</span>
            <span class="text-xs text-base-content/60">Bundle all <%= docs_count %> <%= 'file'.pluralize(docs_count) %> into a single .zip archive</span>
          </div>
        </div>
        <div class="text-base-content/60 group-hover:text-base-content transition-colors shrink-0">
          <%= svg_icon('download', class: 'w-4 h-4 stroke-2') %>
        </div>
      </a>

      <!-- Option 2: Download One by One -->
      <button type="button"
              data-action="download-one-by-one"
              data-date-id="<%= date_id %>"
              data-docs-url="<%= docs_url %>"
              class="w-full flex items-center justify-between p-3 rounded-xl border border-base-300 hover:border-neutral-700 hover:bg-base-200 transition-all group cursor-pointer text-base-content">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-lg bg-base-300 text-base-content flex items-center justify-center shrink-0 shadow">
            <%= svg_icon('files', class: 'w-5 h-5 stroke-2') %>
          </div>
          <div class="flex flex-col text-left">
            <span class="font-semibold text-sm group-hover:text-base-content transition-colors">Download One by One</span>
            <span class="text-xs text-base-content/60">Save each document individually to your device</span>
          </div>
        </div>
        <div class="text-base-content/60 group-hover:text-base-content transition-colors shrink-0">
          <%= svg_icon('download', class: 'w-4 h-4 stroke-2') %>
        </div>
      </button>
    </div>

    <!-- Live progress indicator for One by One -->
    <div id="download_progress_<%= date_id %>" class="hidden mt-4 p-3 bg-base-200 rounded-xl space-y-2 border border-base-300">
      <div class="flex items-center justify-between text-xs font-semibold text-base-content">
        <span id="download_progress_text_<%= date_id %>" class="truncate max-w-xs">Preparing downloads...</span>
        <span id="download_progress_count_<%= date_id %>" class="font-mono text-base-content font-bold"></span>
      </div>
      <progress id="download_progress_bar_<%= date_id %>" class="progress w-full h-2" value="0" max="100"></progress>
    </div>

    <div class="flex mt-4 pt-3 border-t border-base-200">
      <div class="w-full flex justify-end">
        <button type="button"
                data-action="close-download-modal"
                data-target="download_modal_<%= date_id %>"
                class="btn btn-sm btn-ghost font-normal">Cancel</button>
      </div>
    </div>
  </div>
  <div class="modal-backdrop" data-action="close-download-modal" data-target="download_modal_<%= date_id %>">
    <button type="button">close</button>
  </div>
</dialog>
